<Window x:Class="LyricalWidget.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:LyricalWidget.Common"
        Title="What's New - LyricalWidget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Inter, Segoe UI Variable Text, Segoe UI">
    <Grid Margin="32">
        <!-- Shadow on its own layer so text is not rasterized by the effect -->
        <Border CornerRadius="20" Background="#07080B">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" Direction="270" ShadowDepth="4" Color="#000000" Opacity="0.75"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="20" Width="500" Background="#07080B" BorderBrush="#17FFFFFF" BorderThickness="1">
            <Grid>
                <Border VerticalAlignment="Top" Height="1" Margin="24,0,24,0" Background="{StaticResource ChromeSheenBrush}"/>

                <StackPanel Margin="24,24,24,22">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#0E1016"
                                BorderBrush="#17FFFFFF" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Image x:Name="ImgIcon" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Margin="5"/>
                        </Border>
                        <TextBlock Text="What's New" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ChromeTextBrush}" VerticalAlignment="Center"/>

                        <!-- Version pill (AppVersionInfo) -->
                        <Border CornerRadius="9" Background="#111218" BorderBrush="#1CFFFFFF" BorderThickness="1"
                                Padding="8,2" Margin="10,3,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static common:AppVersionInfo.VersionTag}" FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                       FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ChromeTextBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Fixed height so the window does not jump when the notes arrive -->
                    <Border Height="284" CornerRadius="14" Background="#0E1016" BorderBrush="#17FFFFFF" BorderThickness="1">
                        <Grid>
                            <TextBlock x:Name="TxtLoading" Text="Loading release notes..." FontSize="12.5" Foreground="#A1A1AA"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="2" FocusVisualStyle="{x:Null}">
                                <StackPanel x:Name="NotesList" Margin="16,14"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Button x:Name="BtnGotIt" Content="Got it" Style="{StaticResource ChromePrimaryButton}" HorizontalAlignment="Right"
                            Margin="0,18,0,0" IsDefault="True" IsCancel="True" Click="OnGotItClicked"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
