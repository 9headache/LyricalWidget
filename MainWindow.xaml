<Window x:Class="LyricalWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LyricalWidget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="640"
        Height="280"
        MinWidth="320"
        MinHeight="160"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Top Edge Inner Sheen -->
        <LinearGradientBrush x:Key="TopSheenBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00FFFFFF" Offset="0.0"/>
            <GradientStop Color="#55FFFFFF" Offset="0.5"/>
            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Specular rim for Glassify Fluid Glass -->
        <LinearGradientBrush x:Key="SpecularGlassBorder" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#60FFFFFF" Offset="0.0"/>
            <GradientStop Color="#30A1A1AA" Offset="0.45"/>
            <GradientStop Color="#14FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DefaultProgressGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#A1A1AA" Offset="0.0"/>
            <GradientStop Color="#FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Slider Theme Style -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4" CornerRadius="2" Background="#27272A" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton IsHitTestVisible="False" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#52525B" Offset="0.0"/>
                                                            <GradientStop Color="#F4F4F5" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="6" Background="{StaticResource ChromeFillBrush}" BorderBrush="#52525B" BorderThickness="1">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.5"/>
                                                    </Border.Effect>
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Pill Button Style -->
        <Style x:Key="ToolbarPillButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#25FFFFFF"/>
            <Setter Property="Background" Value="#1AFFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Media Control Icon Button Style -->
        <Style x:Key="MediaControlIconBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#40FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnCircle" CornerRadius="15" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnCircle" Property="Background" Value="#66FFFFFF"/>
                                <Setter TargetName="btnCircle" Property="BorderBrush" Value="#80FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="LayoutRoot" Margin="8">
        <Grid.RowDefinitions>
            <!-- Row 0: Floating Unlock Toolbar (Alt + L) -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Main Content Card -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- FLOATING UNLOCK TOOLBAR                    -->
        <!-- ========================================== -->
        <Border Grid.Row="0" x:Name="UnlockToolbar" Visibility="Collapsed"
                CornerRadius="14" Margin="0,0,0,8" Padding="12,8"
                Background="#F00E1016" BorderBrush="#1AFFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel Orientation="Vertical">
                <!-- Row 1: Mode Selectors, Background, Lines, Intensity, Alignment, Lock -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Mode -->
                        <TextBlock Text="Mode:" FontSize="10.5" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Button x:Name="BtnModeLyricsOnly" Content="Lyrics Only" Style="{StaticResource ToolbarPillButton}" Margin="0,0,3,0" Click="OnModeLyricsOnlyClicked"/>
                        <Button x:Name="BtnModeSideBySide" Content="Album + Lyrics" Style="{StaticResource ToolbarPillButton}" Margin="0,0,3,0" Click="OnModeSideBySideClicked"/>
                        <Button x:Name="BtnModeAlbumOnly" Content="Album Only" Style="{StaticResource ToolbarPillButton}" Margin="0,0,7,0" Click="OnModeAlbumOnlyClicked"/>

                        <!-- Background Style -->
                        <TextBlock Text="Bg:" FontSize="10.5" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="2,0,5,0"/>
                        <Button x:Name="BtnBgTransparent" Content="Transparent" Style="{StaticResource ToolbarPillButton}" Margin="0,0,3,0" Click="OnBgTransparentClicked"/>
                        <Button x:Name="BtnBgGlass" Content="Glassify" Style="{StaticResource ToolbarPillButton}" Margin="0,0,7,0" Click="OnBgGlassClicked"/>

                        <!-- Visible Lines Count -->
                        <TextBlock Text="Lines:" FontSize="10.5" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="2,0,5,0"/>
                        <Button x:Name="BtnLinesAuto" Content="Auto" Style="{StaticResource ToolbarPillButton}" Margin="0,0,2,0" Click="OnLinesAutoClicked"/>
                        <Button x:Name="BtnLines2" Content="2" Style="{StaticResource ToolbarPillButton}" Margin="0,0,2,0" Click="OnLines2Clicked"/>
                        <Button x:Name="BtnLines3" Content="3" Style="{StaticResource ToolbarPillButton}" Margin="0,0,2,0" Click="OnLines3Clicked"/>
                        <Button x:Name="BtnLines5" Content="5" Style="{StaticResource ToolbarPillButton}" Margin="0,0,7,0" Click="OnLines5Clicked"/>

                        <!-- Animation Style -->
                        <TextBlock Text="Motion:" FontSize="10.5" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="2,0,5,0"/>
                        <Button x:Name="BtnMotionFluid" Content="Fluid" Style="{StaticResource ToolbarPillButton}" Margin="0,0,7,0" Click="OnMotionFluidClicked" ToolTip="Fluid Wave"/>

                        <!-- Alignment toggle for Lyrics Only mode -->
                        <StackPanel x:Name="AlignTogglePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="Align:" FontSize="10.5" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="2,0,5,0"/>
                            <Button x:Name="BtnAlignCenter" Content="Center" Style="{StaticResource ToolbarPillButton}" Margin="0,0,3,0" Click="OnAlignCenterClicked"/>
                            <Button x:Name="BtnAlignLeft" Content="Left" Style="{StaticResource ToolbarPillButton}" Click="OnAlignLeftClicked"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnFullscreenVibe" Content="Vibe (Alt+F)" Style="{StaticResource ToolbarPillButton}"
                                Margin="0,0,8,0" Click="OnFullscreenVibeClicked" ToolTip="Open Fullscreen Vibe Mode"/>
                        <TextBlock x:Name="LblLockShortcut" Text="Alt + L" FontSize="10" Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button x:Name="BtnLockOverlay" Content="Lock" Style="{StaticResource ToolbarPillButton}"
                                Background="#2EFFFFFF" BorderBrush="#A1A1AA" Foreground="#F4F4F5" Click="OnLockClicked"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Sliders & Checkboxes -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="Font Size" FontSize="10" Foreground="#A1A1AA"/>
                            <TextBlock x:Name="LblFontSize" Text="22px" FontSize="10" Foreground="#D4D4D8" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="SliderFontSize" Style="{StaticResource ModernSlider}" Minimum="14" Maximum="36" Value="22"
                                SmallChange="1" LargeChange="2" Margin="0,3,0,0" ValueChanged="OnFontSizeChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="Opacity" FontSize="10" Foreground="#A1A1AA"/>
                            <TextBlock x:Name="LblOpacity" Text="95%" FontSize="10" Foreground="#D4D4D8" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="SliderOpacity" Style="{StaticResource ModernSlider}" Minimum="0.30" Maximum="1.0" Value="0.95"
                                SmallChange="0.05" LargeChange="0.1" Margin="0,3,0,0" ValueChanged="OnOpacityChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Grid>
                            <TextBlock Text="Sync Offset (Alt+[/])" FontSize="10" Foreground="#A1A1AA"/>
                            <TextBlock x:Name="LblSyncOffset" Text="+150 ms" FontSize="10" Foreground="#D4D4D8" HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="SliderSyncOffset" Style="{StaticResource ModernSlider}" Minimum="-500" Maximum="500" Value="150"
                                SmallChange="50" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="50" Margin="0,3,0,0"
                                ValueChanged="OnSyncOffsetChanged"/>
                    </StackPanel>

                    <!-- Checkboxes -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                        <CheckBox x:Name="ChkThemeLyrics" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Checked="OnThemeLyricsChecked" Unchecked="OnThemeLyricsChecked">
                            <TextBlock Text="Theme Lyrics" FontSize="10.5" Foreground="#D4D4D8"/>
                        </CheckBox>
                        <CheckBox x:Name="ChkGamingMode" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Checked="OnGamingModeChecked" Unchecked="OnGamingModeChecked">
                            <TextBlock Text="Game Mode" FontSize="10.5" FontWeight="SemiBold" Foreground="#F4F4F5"/>
                        </CheckBox>
                        <CheckBox x:Name="ChkEcoFps" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Checked="OnEcoFpsChecked" Unchecked="OnEcoFpsChecked">
                            <TextBlock Text="30 FPS" FontSize="10.5" Foreground="#D4D4D8"/>
                        </CheckBox>
                        <CheckBox x:Name="ChkTrackBanner" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Checked="OnTrackBannerChecked" Unchecked="OnTrackBannerChecked">
                            <TextBlock Text="Banner" FontSize="10.5" Foreground="#D4D4D8"/>
                        </CheckBox>
                        <CheckBox x:Name="ChkAutoHide" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Checked="OnAutoHideChecked" Unchecked="OnAutoHideChecked">
                            <TextBlock Text="Auto-hide" FontSize="10.5" Foreground="#D4D4D8"/>
                        </CheckBox>
                        <CheckBox x:Name="ChkIdleClock" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Checked="OnIdleClockChecked" Unchecked="OnIdleClockChecked">
                            <TextBlock Text="Idle Clock" FontSize="10.5" Foreground="#D4D4D8"/>
                        </CheckBox>
                        <CheckBox x:Name="ChkSubLines" VerticalAlignment="Center" Margin="0,0,8,0"
                                  Checked="OnSubLinesChecked" Unchecked="OnSubLinesChecked">
                            <TextBlock Text="Sub-lines" FontSize="10.5" Foreground="#D4D4D8"/>
                        </CheckBox>
                        <CheckBox x:Name="ChkAudioReactive" VerticalAlignment="Center"
                                  Checked="OnAudioReactiveChecked" Unchecked="OnAudioReactiveChecked">
                            <TextBlock Text="Aura Breath" FontSize="10.5" Foreground="#D4D4D8"/>
                        </CheckBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ========================================== -->
        <!-- MAIN WIDGET CARD (Glassify Specular Rim)   -->
        <!-- ========================================== -->
        <Border Grid.Row="1" x:Name="CardBorder" CornerRadius="22" ClipToBounds="True" Background="Transparent"
                BorderThickness="0" BorderBrush="Transparent">
            <Border.Effect>
                <DropShadowEffect x:Name="CardDropShadow" BlurRadius="24" Direction="270" ShadowDepth="4" Color="#000000" Opacity="0.5"/>
            </Border.Effect>

            <Grid x:Name="CardContentGrid">
                <!-- Background Layer: Baked Ambient Glass Backdrop (No real-time GPU blur!) -->
                <Grid x:Name="GlassBackgroundContainer" Visibility="Collapsed">
                    <Image x:Name="BackdropImageA" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.32"/>
                    <Image x:Name="BackdropImageB" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                    <Border Background="#AA0B0E14"/>
                    <Border x:Name="TopSheenBorder" VerticalAlignment="Top" Height="1.5" Margin="22,0,22,0"
                            Background="{StaticResource TopSheenBrush}" CornerRadius="1"/>
                </Grid>

                <!-- ========================================== -->
                <!-- MEDIA CONTENT ROOT (Mutually Exclusive)    -->
                <!-- ========================================== -->
                <Grid x:Name="MediaContentRoot">
                    <!-- ========================================== -->
                    <!-- DISPLAY MODE 1: LYRICS ONLY                -->
                    <!-- ========================================== -->
                    <Grid x:Name="LyricsOnlyView" Visibility="Collapsed" Margin="14,8,14,10">
                    <Grid.RowDefinitions>
                        <!-- Dedicated Row 0: Docked Track Switch Banner (only in Lyrics Only mode, never overlapping lyrics) -->
                        <RowDefinition Height="Auto"/>
                        <!-- Row 1: Clipped Lyrics Viewport -->
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Docked Track Switch Banner -->
                    <Border Grid.Row="0" x:Name="TrackSwitchBanner" HorizontalAlignment="Center"
                            Margin="0,0,0,8" CornerRadius="12" Padding="10,5" Opacity="0" Visibility="Collapsed">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="BannerTranslateTransform" Y="-14"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect x:Name="BannerDropShadow" BlurRadius="14" Direction="270" ShadowDepth="2" Color="#000000" Opacity="0.6"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6"
                                    Background="#111218" BorderBrush="#33FFFFFF" BorderThickness="1"
                                    ClipToBounds="True" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Image x:Name="BannerAlbumArt" Stretch="UniformToFill"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="BannerMicroLabel" Text="NOW PLAYING" FontSize="8.5" FontWeight="Bold"
                                           Foreground="#D4D4D8" Margin="0,0,0,1"/>
                                <TextBlock x:Name="BannerTrackTitle" Text="Track Title" FontSize="11" FontWeight="Bold"
                                           Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                <TextBlock x:Name="BannerTrackArtist" Text="Artist" FontSize="9.5" Foreground="#A1A1AA"
                                           TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Clipped Viewport with Dynamic Opacity Mask -->
                    <Border Grid.Row="1" x:Name="LyricsOnlyViewport" ClipToBounds="True">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0.0"/>
                                <GradientStop x:Name="LyricsOnlyMaskTop" Color="#FF000000" Offset="0.10"/>
                                <GradientStop x:Name="LyricsOnlyMaskBottom" Color="#FF000000" Offset="0.90"/>
                                <GradientStop Color="#00000000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>

                        <Canvas x:Name="LyricsOnlyCanvas" ClipToBounds="True"/>
                    </Border>
                </Grid>

                <!-- ========================================== -->
                <!-- DISPLAY MODE 2: ALBUM ART + LYRICS         -->
                <!-- ========================================== -->
                <Grid x:Name="SideBySideView" Visibility="Visible" Margin="16,12,16,12">
                    <Grid.ColumnDefinitions>
                        <!-- Left Column: Album Art + Meta + Progress Bar matching art width -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Right Column: Spicy Lyrics Fluid Viewport -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Album Art + Meta + Progress Bar -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,18,0">
                        <!-- Square Album Art (~150px) with Rounded RectangleGeometry Clip & Ambient Aura Glow -->
                        <Border x:Name="SideAlbumBorder" Width="150" Height="150" CornerRadius="14" Background="#0E1016">
                            <Border.Effect>
                                <DropShadowEffect x:Name="SideAlbumAuraGlow" BlurRadius="26" ShadowDepth="4" Direction="270" Color="#A1A1AA" Opacity="0.55"/>
                            </Border.Effect>
                            <Grid>
                                <Path x:Name="SideFallbackIcon" Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                      Fill="#71717A" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="SideAlbumArtImage" Stretch="UniformToFill">
                                    <Image.Clip>
                                        <RectangleGeometry RadiusX="14" RadiusY="14" Rect="0,0,150,150"/>
                                    </Image.Clip>
                                </Image>

                                <!-- Quick Media Controls Frosted Pill (Unlocked Hover or Left Alt + Shift) -->
                                <Border x:Name="SideMediaControlsOverlay" CornerRadius="18" Background="#E00E1016"
                                        BorderBrush="#55FFFFFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Padding="7,4" Opacity="0" Visibility="Collapsed">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#000000" Opacity="0.6"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="SideBtnPrev" Style="{StaticResource MediaControlIconBtn}" Click="OnMediaPrevClicked" ToolTip="Previous Track">
                                            <Path Data="M6 6h2v12H6zm3.5 6l8.5 6V6z" Fill="#FFFFFF" Stretch="Uniform" Width="11" Height="11"/>
                                        </Button>
                                        <Button x:Name="SideBtnPlayPause" Style="{StaticResource MediaControlIconBtn}" Click="OnMediaPlayPauseClicked" Margin="5,0" ToolTip="Play / Pause">
                                            <Path x:Name="SidePlayPauseIcon" Data="M8 5v14l11-7z" Fill="#FFFFFF" Stretch="Uniform" Width="12" Height="12"/>
                                        </Button>
                                        <Button x:Name="SideBtnNext" Style="{StaticResource MediaControlIconBtn}" Click="OnMediaNextClicked" ToolTip="Next Track">
                                            <Path Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" Fill="#FFFFFF" Stretch="Uniform" Width="11" Height="11"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="SideTrackTitle" Text="Track Title" FontSize="13" FontWeight="Bold"
                                   Foreground="#F4F4F5" TextTrimming="CharacterEllipsis" MaxWidth="150" Margin="0,8,0,0"/>
                        <TextBlock x:Name="SideTrackArtist" Text="Artist" FontSize="11" Foreground="#A1A1AA"
                                   TextTrimming="CharacterEllipsis" MaxWidth="150" Margin="0,2,0,0"/>

                        <!-- Progress Bar (strictly 150px Album Art Width) -->
                        <Border Width="150" Height="3" CornerRadius="1.5" Background="#26FFFFFF" Margin="0,8,0,0">
                            <Grid HorizontalAlignment="Left" x:Name="SideProgressFill" Width="0">
                                <Border x:Name="SideProgressBarBorder" CornerRadius="1.5" Background="{StaticResource DefaultProgressGradient}"/>
                            </Grid>
                        </Border>

                        <Grid Width="150" Margin="0,3,0,0">
                            <TextBlock x:Name="SideCurrentTime" Text="0:00" FontSize="9.5" FontFamily="Consolas, Segoe UI" Foreground="#A1A1AA" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="SideTotalTime" Text="0:00" FontSize="9.5" FontFamily="Consolas, Segoe UI" Foreground="#A1A1AA" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <!-- Right Column: Spicy Lyrics Viewport with Canvas -->
                    <Border Grid.Column="1" x:Name="SideLyricsViewport" ClipToBounds="True">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0.0"/>
                                <GradientStop x:Name="SideLyricsMaskTop" Color="#FF000000" Offset="0.10"/>
                                <GradientStop x:Name="SideLyricsMaskBottom" Color="#FF000000" Offset="0.90"/>
                                <GradientStop Color="#00000000" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>

                        <Canvas x:Name="SideLyricsCanvas" ClipToBounds="True"/>
                    </Border>
                </Grid>

                <!-- ======================================================== -->
                <!-- DISPLAY MODE 3: ALBUM ART ONLY (Instagram Story Style)   -->
                <!-- ======================================================== -->
                <Grid x:Name="AlbumOnlyView" Visibility="Collapsed" Margin="16,12,16,12" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <!-- Square Album Art (~165px) with Ambient Aura Glow -->
                        <Border x:Name="AlbumOnlyBorder" Width="165" Height="165" CornerRadius="16" Background="#0E1016" HorizontalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect x:Name="AlbumOnlyShadow" BlurRadius="26" ShadowDepth="4" Direction="270" Color="#A1A1AA" Opacity="0.55"/>
                            </Border.Effect>
                            <Grid>
                                <Path x:Name="AlbumOnlyFallbackIcon" Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                      Fill="#71717A" Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="AlbumOnlyImage" Stretch="UniformToFill">
                                    <Image.Clip>
                                        <RectangleGeometry RadiusX="16" RadiusY="16" Rect="0,0,165,165"/>
                                    </Image.Clip>
                                </Image>

                                <!-- Quick Media Controls Frosted Pill (Unlocked Hover or Left Alt + Shift) -->
                                <Border x:Name="AlbumOnlyMediaControlsOverlay" CornerRadius="18" Background="#E00E1016"
                                        BorderBrush="#55FFFFFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Padding="8,5" Opacity="0" Visibility="Collapsed">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" Direction="270" ShadowDepth="2" Color="#000000" Opacity="0.6"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="AlbumBtnPrev" Style="{StaticResource MediaControlIconBtn}" Click="OnMediaPrevClicked" ToolTip="Previous Track">
                                            <Path Data="M6 6h2v12H6zm3.5 6l8.5 6V6z" Fill="#FFFFFF" Stretch="Uniform" Width="11" Height="11"/>
                                        </Button>
                                        <Button x:Name="AlbumBtnPlayPause" Style="{StaticResource MediaControlIconBtn}" Click="OnMediaPlayPauseClicked" Margin="6,0" ToolTip="Play / Pause">
                                            <Path x:Name="AlbumPlayPauseIcon" Data="M8 5v14l11-7z" Fill="#FFFFFF" Stretch="Uniform" Width="13" Height="13"/>
                                        </Button>
                                        <Button x:Name="AlbumBtnNext" Style="{StaticResource MediaControlIconBtn}" Click="OnMediaNextClicked" ToolTip="Next Track">
                                            <Path Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" Fill="#FFFFFF" Stretch="Uniform" Width="11" Height="11"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Progress Bar (strictly 165px Album Art Width) -->
                        <Border Width="165" Height="3.5" CornerRadius="1.75" Background="#26FFFFFF" Margin="0,10,0,0">
                            <Grid HorizontalAlignment="Left" x:Name="AlbumOnlyProgressFill" Width="0">
                                <Border x:Name="AlbumOnlyProgressBarBorder" CornerRadius="1.75" Background="{StaticResource DefaultProgressGradient}"/>
                            </Grid>
                        </Border>

                        <Grid Width="165" Margin="0,3,0,0">
                            <TextBlock x:Name="AlbumOnlyCurrentTime" Text="0:00" FontSize="9.5" FontFamily="Consolas, Segoe UI" Foreground="#A1A1AA" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="AlbumOnlyTotalTime" Text="0:00" FontSize="9.5" FontFamily="Consolas, Segoe UI" Foreground="#A1A1AA" HorizontalAlignment="Right"/>
                        </Grid>

                        <TextBlock x:Name="AlbumOnlyTrackTitle" Text="Track Title" FontSize="15" FontWeight="Bold"
                                   Foreground="#F4F4F5" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="280" Margin="0,8,0,0"/>
                        <TextBlock x:Name="AlbumOnlyTrackArtist" Text="Artist" FontSize="12" Foreground="#A1A1AA"
                                   TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="280" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
                </Grid>

                <!-- ========================================== -->
                <!-- IDLE CLOCK ROOT (Glassify Single-Digit)    -->
                <!-- ========================================== -->
                <Grid x:Name="IdleClockRoot" Visibility="Collapsed" Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,16">
                    <Grid.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.45"/>
                    </Grid.Effect>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                        <!-- Digit Rollers Row -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <!-- Digit H1 -->
                            <Border Width="38" Height="58" ClipToBounds="True">
                                <Canvas Width="38" Height="58">
                                    <TextBlock x:Name="ClockH1Current" Text="0" FontSize="46" FontWeight="Bold" Foreground="#FFFFFF"
                                               Width="38" TextAlignment="Center" Canvas.Top="0"/>
                                    <TextBlock x:Name="ClockH1Next" Text="1" FontSize="46" FontWeight="Bold" Foreground="#FFFFFF"
                                               Width="38" TextAlignment="Center" Canvas.Top="58" Opacity="0"/>
                                </Canvas>
                            </Border>
                            <!-- Digit H2 -->
                            <Border Width="38" Height="58" ClipToBounds="True">
                                <Canvas Width="38" Height="58">
                                    <TextBlock x:Name="ClockH2Current" Text="0" FontSize="46" FontWeight="Bold" Foreground="#FFFFFF"
                                               Width="38" TextAlignment="Center" Canvas.Top="0"/>
                                    <TextBlock x:Name="ClockH2Next" Text="1" FontSize="46" FontWeight="Bold" Foreground="#FFFFFF"
                                               Width="38" TextAlignment="Center" Canvas.Top="58" Opacity="0"/>
                                </Canvas>
                            </Border>
                            <!-- Colon -->
                            <TextBlock Text=":" FontSize="42" FontWeight="Bold" Foreground="#99FFFFFF" VerticalAlignment="Center" Margin="3,-6,3,0"/>
                            <!-- Digit M1 -->
                            <Border Width="38" Height="58" ClipToBounds="True">
                                <Canvas Width="38" Height="58">
                                    <TextBlock x:Name="ClockM1Current" Text="0" FontSize="46" FontWeight="Bold" Foreground="#FFFFFF"
                                               Width="38" TextAlignment="Center" Canvas.Top="0"/>
                                    <TextBlock x:Name="ClockM1Next" Text="1" FontSize="46" FontWeight="Bold" Foreground="#FFFFFF"
                                               Width="38" TextAlignment="Center" Canvas.Top="58" Opacity="0"/>
                                </Canvas>
                            </Border>
                            <!-- Digit M2 -->
                            <Border Width="38" Height="58" ClipToBounds="True">
                                <Canvas Width="38" Height="58">
                                    <TextBlock x:Name="ClockM2Current" Text="0" FontSize="46" FontWeight="Bold" Foreground="#FFFFFF"
                                               Width="38" TextAlignment="Center" Canvas.Top="0"/>
                                    <TextBlock x:Name="ClockM2Next" Text="1" FontSize="46" FontWeight="Bold" Foreground="#FFFFFF"
                                               Width="38" TextAlignment="Center" Canvas.Top="58" Opacity="0"/>
                                </Canvas>
                            </Border>
                        </StackPanel>

                        <!-- Date Text -->
                        <TextBlock x:Name="IdleClockDateText" Text="Wednesday, November 23" FontSize="12.5" FontWeight="Medium"
                                   Foreground="#B3FFFFFF" TextAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Snap-to-Edge & Center Alignment Guide Lines (1px, 35% opacity) -->
        <Grid Grid.Row="1" IsHitTestVisible="False">
            <Border x:Name="SnapGuideLeft" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="1" Background="#F4F4F5" Opacity="0.35" Visibility="Collapsed"/>
            <Border x:Name="SnapGuideRight" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="1" Background="#F4F4F5" Opacity="0.35" Visibility="Collapsed"/>
            <Border x:Name="SnapGuideTop" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="1" Background="#F4F4F5" Opacity="0.35" Visibility="Collapsed"/>
            <Border x:Name="SnapGuideBottom" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="1" Background="#F4F4F5" Opacity="0.35" Visibility="Collapsed"/>
            <Border x:Name="SnapGuideCenterX" HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="1" Background="#F4F4F5" Opacity="0.35" Visibility="Collapsed"/>
            <Border x:Name="SnapGuideCenterY" HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="1" Background="#F4F4F5" Opacity="0.35" Visibility="Collapsed"/>
        </Grid>

        <!-- Resize Grip in Bottom-Right Corner (Only visible when unlocked) -->
        <Thumb x:Name="ResizeGripThumb" Grid.Row="1" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Margin="0,0,10,10" Cursor="SizeNWSE" Visibility="Collapsed" Opacity="0.5">
            <Thumb.Template>
                <ControlTemplate>
                    <Path Data="M10,0 L14,0 L14,14 L0,14 L0,10 L10,10 Z M6,6 L10,6 L10,10 L6,10 Z" Fill="#D4D4D8" Stretch="Uniform"/>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>
