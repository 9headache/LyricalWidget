<Window x:Class="LyricalWidget.FullscreenVibeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LyricalWidget - Vibe"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Width="1280" Height="800" MinWidth="420" MinHeight="380"
        Background="#050608"
        WindowStartupLocation="Manual"
        Focusable="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="VibeIconButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#25FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#30FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="21" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#55FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#80FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillBarButton" TargetType="Button">
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#33FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pillBorder" CornerRadius="12" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pillBorder" Property="Background" Value="#45FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="10" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#2A2B33"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PacingMicroButton" TargetType="Button">
            <Setter Property="Foreground" Value="#8B8B94"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="12" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#181A22"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#1AFFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource ChromeFillBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HoverMenuItem" TargetType="Button">
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="row" CornerRadius="8" Background="Transparent" Padding="10,8" Margin="0,1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="dot" Width="6" Height="6" Margin="0,0,9,0" VerticalAlignment="Center"
                                         Fill="{StaticResource ChromeFillBrush}" Visibility="Hidden"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Active">
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="row" Property="Background" Value="#0E1016"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="#181A22"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" ClipToBounds="True">
        <!-- Tinted background -->
        <Border x:Name="TintedBackground" Background="#07080B" Panel.ZIndex="0" IsHitTestVisible="False"/>

        <!-- Background orbs, the only part moved by CanvasShakeTransform -->
        <Canvas x:Name="BackgroundOrbsCanvas" IsHitTestVisible="False" ClipToBounds="False" Panel.ZIndex="1">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="CanvasShakeTransform" X="0" Y="0"/>
            </Canvas.RenderTransform>

            <!-- Orb 0: Primary -->
            <Ellipse x:Name="Orb0" Width="1000" Height="1000" Opacity="0.78">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop x:Name="Orb0Stop0" Color="#A1A1AA" Offset="0.0"/>
                        <GradientStop x:Name="Orb0Stop1" Color="#00A1A1AA" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="Orb0Scale" ScaleX="1.0" ScaleY="1.0" CenterX="500" CenterY="500"/>
                        <TranslateTransform x:Name="Orb0Translate" X="0" Y="0"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Orb 1: Secondary -->
            <Ellipse x:Name="Orb1" Width="1000" Height="1000" Opacity="0.70">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop x:Name="Orb1Stop0" Color="#52525B" Offset="0.0"/>
                        <GradientStop x:Name="Orb1Stop1" Color="#0052525B" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="Orb1Scale" ScaleX="1.0" ScaleY="1.0" CenterX="500" CenterY="500"/>
                        <TranslateTransform x:Name="Orb1Translate" X="0" Y="0"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Orb 2: Accent -->
            <Ellipse x:Name="Orb2" Width="1000" Height="1000" Opacity="0.68">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop x:Name="Orb2Stop0" Color="#71717A" Offset="0.0"/>
                        <GradientStop x:Name="Orb2Stop1" Color="#0071717A" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="Orb2Scale" ScaleX="1.0" ScaleY="1.0" CenterX="500" CenterY="500"/>
                        <TranslateTransform x:Name="Orb2Translate" X="0" Y="0"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Orb 3: Highlight -->
            <Ellipse x:Name="Orb3" Width="1000" Height="1000" Opacity="0.62">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop x:Name="Orb3Stop0" Color="#D4D4D8" Offset="0.0"/>
                        <GradientStop x:Name="Orb3Stop1" Color="#00D4D4D8" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="Orb3Scale" ScaleX="1.0" ScaleY="1.0" CenterX="500" CenterY="500"/>
                        <TranslateTransform x:Name="Orb3Translate" X="0" Y="0"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Orb 4: Warm glow -->
            <Ellipse x:Name="Orb4" Width="1000" Height="1000" Opacity="0.58">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop x:Name="Orb4Stop0" Color="#3F3F46" Offset="0.0"/>
                        <GradientStop x:Name="Orb4Stop1" Color="#003F3F46" Offset="1.0"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="Orb4Scale" ScaleX="1.0" ScaleY="1.0" CenterX="500" CenterY="500"/>
                        <TranslateTransform x:Name="Orb4Translate" X="0" Y="0"/>
                    </TransformGroup>
                </Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>

        <!-- Frosted overlay and vignette -->
        <Border Background="#45080A12" IsHitTestVisible="False" Panel.ZIndex="2"/>
        <Border x:Name="VignetteOverlay" IsHitTestVisible="False" Panel.ZIndex="3">
            <Border.Background>
                <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.65" RadiusY="0.65">
                    <GradientStop Color="#00000000" Offset="0.35"/>
                    <GradientStop x:Name="VignetteEdgeStop" Color="#7504060A" Offset="1.0"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>

        <!-- Outlined title marquee along the bottom -->
        <Canvas x:Name="BottomMarqueeCanvas" Panel.ZIndex="3" IsHitTestVisible="False" ClipToBounds="True"
                Height="140" VerticalAlignment="Bottom" Margin="0,0,0,24">
            <StackPanel x:Name="MarqueeStack" Orientation="Horizontal" Opacity="0.05">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="MarqueeTranslate" X="0" Y="0"/>
                </StackPanel.RenderTransform>
            </StackPanel>
        </Canvas>

        <!-- Split mode: landscape and portrait -->
        <!-- Landscape Split Layout (Default) -->
        <Grid x:Name="LandscapeLayout" Margin="48,36,48,36" Panel.ZIndex="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LandscapeColLeft" Width="0.44*"/>
                <ColumnDefinition x:Name="LandscapeColRight" Width="0.56*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Side: Album Art + Meta + Progress + Controls -->
            <Grid x:Name="AlbumSideContainer" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,32,0" ClipToBounds="False">
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" ClipToBounds="False">
                    <StackPanel.LayoutTransform>
                        <ScaleTransform x:Name="LandscapeAlbumScale"/>
                    </StackPanel.LayoutTransform>
                    <!-- Album Cover + Pop-out Volume Bar Shared Hover Zone -->
                    <Grid x:Name="AlbumHoverZone" HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent"
                          Width="442" Margin="0,0,-62,0" ClipToBounds="False">
                        <!-- Album cover -->
                        <Border x:Name="AlbumCardBorder" Width="380" Height="380" HorizontalAlignment="Left" CornerRadius="28" Background="#0E1016">
                            <Border.Effect>
                                <DropShadowEffect x:Name="AlbumAuraGlow" BlurRadius="52" ShadowDepth="8" Direction="270" Color="#D4D4D8" Opacity="0.55"/>
                            </Border.Effect>
                            <Grid>
                                <Path x:Name="AlbumFallbackIcon" Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                      Fill="#71717A" Width="72" Height="72" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image x:Name="AlbumCoverImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.Clip>
                                        <RectangleGeometry RadiusX="28" RadiusY="28" Rect="0,0,380,380"/>
                                    </Image.Clip>
                                </Image>

                                <!-- Scrim behind the hover controls -->
                                <Border x:Name="AlbumCoverScrim" CornerRadius="28" Background="#000000" Opacity="0" IsHitTestVisible="False"/>

                                <!-- Hover-only Media Controls Pill -->
                                <Border x:Name="MediaControlsOverlay" CornerRadius="24" Background="#D00E1016"
                                        BorderBrush="#40FFFFFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Padding="14,8" Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="MediaControlsScale" ScaleX="0.92" ScaleY="0.92"/>
                                    </Border.RenderTransform>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="20" Direction="270" ShadowDepth="3" Color="#000000" Opacity="0.6"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource VibeIconButton}" Click="OnPrevClicked" ToolTip="Previous Track">
                                            <Path Data="M6 6h2v12H6zm3.5 6l8.5 6V6z" Fill="#FFFFFF" Stretch="Uniform" Width="14" Height="14"/>
                                        </Button>
                                        <Button Style="{StaticResource VibeIconButton}" Click="OnPlayPauseClicked" Margin="12,0" ToolTip="Play / Pause">
                                            <Path x:Name="PlayPauseIcon" Data="M8 5v14l11-7z" Fill="#FFFFFF" Stretch="Uniform" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource VibeIconButton}" Click="OnNextClicked" ToolTip="Next Track">
                                            <Path Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" Fill="#FFFFFF" Stretch="Uniform" Width="14" Height="14"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Volume pill, beside the album cover -->
                        <Border x:Name="VolumePopoutPill" Width="40" Height="280" HorizontalAlignment="Left" Margin="396,0,0,0"
                                VerticalAlignment="Center" CornerRadius="20" Background="#DD0E1016" BorderBrush="#38FFFFFF" BorderThickness="1"
                                Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.0,0.5">
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="VolumePillScale" ScaleX="0.92" ScaleY="0.92"/>
                                    <TranslateTransform x:Name="VolumePillTranslate" X="-16" Y="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" Direction="270" ShadowDepth="4" Color="#000000" Opacity="0.65"/>
                            </Border.Effect>
                            <Grid Margin="0,12,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- % Indicator -->
                                    <RowDefinition Height="*"/>    <!-- Slim Volume Bar -->
                                    <RowDefinition Height="Auto"/> <!-- Mute/Speaker Toggle -->
                                </Grid.RowDefinitions>

                                <!-- % Indicator -->
                                <TextBlock x:Name="VolumePercentText" Grid.Row="0" Text="100%" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#D4D4D8" HorizontalAlignment="Center" Margin="0,0,0,8"/>

                                <!-- Volume bar -->
                                <Grid Grid.Row="1" x:Name="VolumeSliderTrack" Cursor="Hand" Background="Transparent" Width="24"
                                      MouseLeftButtonDown="OnVolumeTrackMouseDown" MouseLeftButtonUp="OnVolumeTrackMouseUp" MouseMove="OnVolumeTrackMouseMove">
                                    <!-- Track background line -->
                                    <Border Width="6" CornerRadius="3" Background="#26FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                                    <!-- Fill, anchored at the bottom -->
                                    <Border x:Name="VolumeFillBar" Width="6" CornerRadius="3" Background="#D4D4D8"
                                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="100">
                                        <Border.Effect>
                                            <DropShadowEffect x:Name="VolumeFillGlow" BlurRadius="10" ShadowDepth="0" Color="#D4D4D8" Opacity="0.65"/>
                                        </Border.Effect>
                                    </Border>
                                </Grid>

                                <!-- Mute/Speaker Toggle Button -->
                                <Button Grid.Row="2" Style="{StaticResource VibeIconButton}" Width="32" Height="32" Margin="0,8,0,0"
                                        HorizontalAlignment="Center" Click="OnVolumeMuteToggleClicked" ToolTip="Mute / Unmute">
                                    <Path x:Name="VolumeSpeakerIcon" Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"
                                          Fill="#D4D4D8" Stretch="Uniform" Width="13" Height="13"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Track Metadata -->
                    <TextBlock x:Name="TrackTitleText" Text="Track Title" FontSize="26" FontWeight="Bold"
                               Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="380" Margin="0,22,0,0"/>
                    <TextBlock x:Name="TrackArtistText" Text="Artist Name" FontSize="16" FontWeight="Medium"
                               Foreground="#D4D4D8" TextTrimming="CharacterEllipsis" MaxWidth="380" Margin="0,4,0,0"/>

                    <!-- Interactive Seekable Progress Bar -->
                    <Border x:Name="ProgressBarTrack" Width="380" Height="6" CornerRadius="3" Background="#33FFFFFF"
                            Margin="0,16,0,0" Cursor="Hand" MouseLeftButtonDown="OnProgressBarMouseDown">
                        <Grid HorizontalAlignment="Left" x:Name="ProgressBarFill" Width="0">
                            <Border x:Name="ProgressBarFillBorder" CornerRadius="3">
                                <Border.Background>
                                    <LinearGradientBrush x:Name="ProgressBarGradient" StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="ProgressStop0" Color="#A1A1AA" Offset="0.0"/>
                                        <GradientStop x:Name="ProgressStop1" Color="#FFFFFF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Width="380" Margin="0,6,0,0">
                        <TextBlock x:Name="CurrentTimeText" Text="0:00" FontSize="11" FontFamily="Consolas, Segoe UI" Foreground="#A1A1AA" HorizontalAlignment="Left"/>
                        <TextBlock x:Name="TotalTimeText" Text="0:00" FontSize="11" FontFamily="Consolas, Segoe UI" Foreground="#A1A1AA" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Right side: lyrics, click a line to seek -->
            <Grid x:Name="LyricsSideContainer" Grid.Column="1" ClipToBounds="True" Panel.ZIndex="4">
                <Border x:Name="LyricsViewport" ClipToBounds="True" Visibility="Visible" Opacity="1.0">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0.0"/>
                            <GradientStop x:Name="LyricsMaskTop" Color="#FF000000" Offset="0.12"/>
                            <GradientStop x:Name="LyricsMaskBottom" Color="#FF000000" Offset="0.88"/>
                            <GradientStop Color="#00000000" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.OpacityMask>

                    <Canvas x:Name="LyricsCanvas" ClipToBounds="True" Visibility="Visible" Opacity="1.0"/>
                </Border>
            </Grid>
        </Grid>

        <!-- Portrait / Vertical Monitor Layout (Auto-engaged when Height > Width) -->
        <Grid x:Name="PortraitLayout" Visibility="Collapsed" Margin="24,36,24,24" Panel.ZIndex="4">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="PortraitRowTop" Height="0.38*"/>
                <RowDefinition x:Name="PortraitRowBottom" Height="0.62*"/>
            </Grid.RowDefinitions>

            <!-- Top Row: Compact Album Art & Controls -->
            <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False">
                <StackPanel.LayoutTransform>
                    <ScaleTransform x:Name="PortraitAlbumScale"/>
                </StackPanel.LayoutTransform>
                <!-- Shared Hover Zone for Portrait -->
                <Grid x:Name="PortraitAlbumHoverZone" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent"
                      Width="256" Margin="56,0,0,0" ClipToBounds="False">
                    <Border x:Name="PortraitAlbumCardBorder" Width="200" Height="200" HorizontalAlignment="Left" CornerRadius="20" Background="#0E1016">
                        <Border.Effect>
                            <DropShadowEffect x:Name="PortraitAlbumAuraGlow" BlurRadius="36" ShadowDepth="4" Direction="270" Color="#D4D4D8" Opacity="0.55"/>
                        </Border.Effect>
                        <Grid>
                            <Path x:Name="PortraitAlbumFallbackIcon" Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                  Fill="#71717A" Width="44" Height="44" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="PortraitAlbumCoverImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Clip>
                                    <RectangleGeometry RadiusX="20" RadiusY="20" Rect="0,0,200,200"/>
                                </Image.Clip>
                            </Image>

                            <!-- Scrim -->
                            <Border x:Name="PortraitAlbumCoverScrim" CornerRadius="20" Background="#000000" Opacity="0" IsHitTestVisible="False"/>

                            <!-- Portrait Media Controls Pill -->
                            <Border x:Name="PortraitMediaControlsOverlay" CornerRadius="18" Background="#D00E1016"
                                    BorderBrush="#40FFFFFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Padding="8,4" Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="PortraitMediaControlsScale" ScaleX="0.92" ScaleY="0.92"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" Direction="270" ShadowDepth="2" Color="#000000" Opacity="0.6"/>
                                </Border.Effect>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource VibeIconButton}" Width="32" Height="32" Click="OnPrevClicked" ToolTip="Previous Track">
                                        <Path Data="M6 6h2v12H6zm3.5 6l8.5 6V6z" Fill="#FFFFFF" Stretch="Uniform" Width="10" Height="10"/>
                                    </Button>
                                    <Button Style="{StaticResource VibeIconButton}" Width="32" Height="32" Click="OnPlayPauseClicked" Margin="6,0" ToolTip="Play / Pause">
                                        <Path x:Name="PortraitPlayPauseIcon" Data="M8 5v14l11-7z" Fill="#FFFFFF" Stretch="Uniform" Width="12" Height="12"/>
                                    </Button>
                                    <Button Style="{StaticResource VibeIconButton}" Width="32" Height="32" Click="OnNextClicked" ToolTip="Next Track">
                                        <Path Data="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z" Fill="#FFFFFF" Stretch="Uniform" Width="10" Height="10"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Portrait Pop-Out Volume Pill -->
                    <Border x:Name="PortraitVolumePopoutPill" Width="36" Height="170" HorizontalAlignment="Left" Margin="212,0,0,0"
                            VerticalAlignment="Center" CornerRadius="18" Background="#DD0E1016" BorderBrush="#38FFFFFF" BorderThickness="1"
                            Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.0,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="PortraitVolumePillScale" ScaleX="0.92" ScaleY="0.92"/>
                                <TranslateTransform x:Name="PortraitVolumePillTranslate" X="-12" Y="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" Direction="270" ShadowDepth="3" Color="#000000" Opacity="0.65"/>
                        </Border.Effect>
                        <Grid Margin="0,8,0,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="PortraitVolumePercentText" Grid.Row="0" Text="100%" FontSize="9" FontWeight="SemiBold"
                                       Foreground="#D4D4D8" HorizontalAlignment="Center" Margin="0,0,0,6"/>

                            <Grid Grid.Row="1" x:Name="PortraitVolumeSliderTrack" Cursor="Hand" Background="Transparent" Width="20"
                                  MouseLeftButtonDown="OnPortraitVolumeTrackMouseDown" MouseLeftButtonUp="OnPortraitVolumeTrackMouseUp" MouseMove="OnPortraitVolumeTrackMouseMove">
                                <Border Width="5" CornerRadius="2.5" Background="#26FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                                <Border x:Name="PortraitVolumeFillBar" Width="5" CornerRadius="2.5" Background="#D4D4D8"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Height="60">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="PortraitVolumeFillGlow" BlurRadius="8" ShadowDepth="0" Color="#D4D4D8" Opacity="0.65"/>
                                    </Border.Effect>
                                </Border>
                            </Grid>

                            <Button Grid.Row="2" Style="{StaticResource VibeIconButton}" Width="28" Height="28" Margin="0,6,0,0"
                                    HorizontalAlignment="Center" Click="OnVolumeMuteToggleClicked" ToolTip="Mute / Unmute">
                                <Path x:Name="PortraitVolumeSpeakerIcon" Data="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"
                                      Fill="#D4D4D8" Stretch="Uniform" Width="11" Height="11"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock x:Name="PortraitTrackTitleText" Text="Track Title" FontSize="18" FontWeight="Bold"
                           Foreground="#FFFFFF" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" Margin="0,10,0,0"/>
                <TextBlock x:Name="PortraitTrackArtistText" Text="Artist Name" FontSize="13" Foreground="#D4D4D8"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" Margin="0,2,0,0"/>

                <!-- Interactive Seekable Progress Bar -->
                <Border Width="280" Height="5" CornerRadius="2.5" Background="#33FFFFFF" Margin="0,10,0,0" Cursor="Hand" MouseLeftButtonDown="OnProgressBarMouseDown">
                    <Grid HorizontalAlignment="Left" x:Name="PortraitProgressBarFill" Width="0">
                        <Border x:Name="PortraitProgressBarFillBorder" CornerRadius="2.5">
                            <Border.Background>
                                <LinearGradientBrush x:Name="PortraitProgressBarGradient" StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop x:Name="PortraitProgressStop0" Color="#A1A1AA" Offset="0.0"/>
                                    <GradientStop x:Name="PortraitProgressStop1" Color="#FFFFFF" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Bottom Row: Lyrics Viewport in Portrait -->
            <Border Grid.Row="1" x:Name="PortraitLyricsViewport" ClipToBounds="True" Margin="0,12,0,0" Panel.ZIndex="4" Visibility="Visible" Opacity="1.0">
                <Border.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0.0"/>
                        <GradientStop x:Name="PortraitLyricsMaskTop" Color="#FF000000" Offset="0.10"/>
                        <GradientStop x:Name="PortraitLyricsMaskBottom" Color="#FF000000" Offset="0.90"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.OpacityMask>

                <Canvas x:Name="PortraitLyricsCanvas" ClipToBounds="True" Visibility="Visible" Opacity="1.0"/>
            </Border>
        </Grid>

        <!-- Editorial and Poster preset host -->
        <Grid x:Name="KineticStandardHost" Panel.ZIndex="4" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True">
            <Border x:Name="PosterBackdrop" Visibility="Collapsed" IsHitTestVisible="False" Background="#09090B"/>

            <Canvas x:Name="KineticViewportCanvas" ClipToBounds="True" IsHitTestVisible="False"
                    Visibility="Visible" Opacity="1.0">
                <Canvas x:Name="KineticWorldCanvas" ClipToBounds="False">
                    <Canvas.RenderTransform>
                        <MatrixTransform x:Name="WorldCameraMatrix"/>
                    </Canvas.RenderTransform>
                </Canvas>
            </Canvas>
        </Grid>

        <!-- SpotlightFog preset host -->
        <Grid x:Name="SpotlightFogHost" Panel.ZIndex="4" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True">
            <Grid x:Name="SpotlightArtworkGroup" Opacity="1.0">
                <Image x:Name="SpotlightSharpImage" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="SpotlightSharpScale" ScaleX="1.0" ScaleY="1.0"/>
                    </Image.RenderTransform>
                </Image>

                <Image x:Name="SpotlightBlurredImage" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="SpotlightBlurredScale" ScaleX="1.0" ScaleY="1.0"/>
                    </Image.RenderTransform>
                    <Image.OpacityMask>
                        <RadialGradientBrush x:Name="SpotlightFogMask" Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop x:Name="FogStop0" Color="#FF000000" Offset="0.0"/>
                            <GradientStop x:Name="FogStop1" Color="#CC000000" Offset="0.30"/>
                            <GradientStop x:Name="FogStop2" Color="#55000000" Offset="0.65"/>
                            <GradientStop x:Name="FogStop3" Color="#00000000" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Image.OpacityMask>
                </Image>

                <Border x:Name="SpotlightVignette" Background="#000000" Opacity="0.48" IsHitTestVisible="False">
                    <Border.OpacityMask>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.65" RadiusY="0.55">
                            <GradientStop Color="#FF000000" Offset="0.0"/>
                            <GradientStop Color="#DD000000" Offset="0.30"/>
                            <GradientStop Color="#55000000" Offset="0.65"/>
                            <GradientStop Color="#00000000" Offset="1.0"/>
                        </RadialGradientBrush>
                    </Border.OpacityMask>
                </Border>
            </Grid>

            <Canvas x:Name="SpotlightLyricsCanvas" ClipToBounds="True" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Grid>

        <!-- Moonlight Bloom preset host -->
        <Grid x:Name="MoonlightHost" Panel.ZIndex="4" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True" Background="#050608">
            <!-- Only this part goes through the lens. With it on, the wrapper is invisible and the viewport paints the stage. -->
            <Grid x:Name="MoonlightStageWrap">
            <Grid x:Name="MoonlightStage" ClipToBounds="True" Background="#050608">
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.62" RadiusY="0.58">
                        <GradientStop Color="#24FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#12FFFFFF" Offset="0.38"/>
                        <GradientStop Color="#05FFFFFF" Offset="0.72"/>
                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Canvas x:Name="MoonlightCanvas" Margin="0,48" ClipToBounds="False"/>
            </Grid>
            </Grid>

            <Viewport3D x:Name="MoonlightLensViewport" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True"/>
            <Border x:Name="MoonlightLensVignette" Visibility="Collapsed" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.64" RadiusY="0.64">
                        <GradientStop Color="#00050608" Offset="0.58"/>
                        <GradientStop Color="#70050608" Offset="0.80"/>
                        <GradientStop Color="#F2050608" Offset="1.0"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
        </Grid>

        <!-- LiveCode preset host -->
        <Grid x:Name="LiveCodeHost" Panel.ZIndex="4" Visibility="Collapsed" IsHitTestVisible="False" ClipToBounds="True">
            <Grid x:Name="LiveCodeArtworkGroup" Opacity="1.0" Margin="-200">
                <Image x:Name="LiveCodeBackdropImage" Stretch="UniformToFill" RenderTransformOrigin="0.5,0.5"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="LiveCodeBackdropScale" ScaleX="1.25" ScaleY="1.25"/>
                            <TranslateTransform x:Name="LiveCodeBackdropParallax" X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Grid>

            <Border Background="#880A0D14" IsHitTestVisible="False"/>
            <Border Background="#2E000000" IsHitTestVisible="False">
                <Border.OpacityMask>
                    <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.75" RadiusY="0.65">
                        <GradientStop Color="#00000000" Offset="0.30"/>
                        <GradientStop Color="#80000000" Offset="0.75"/>
                        <GradientStop Color="#C0000000" Offset="1.00"/>
                    </RadialGradientBrush>
                </Border.OpacityMask>
            </Border>

            <Canvas x:Name="LiveCodeViewportCanvas" ClipToBounds="True">
                <Canvas x:Name="LiveCodeEditorCanvas" ClipToBounds="False">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="LiveCodeCameraScale" ScaleX="1.0" ScaleY="1.0" CenterX="0" CenterY="0"/>
                            <TranslateTransform x:Name="LiveCodeCameraTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <Canvas x:Name="LiveCodeHighlightsCanvas" ClipToBounds="False"/>
                    <Canvas x:Name="LiveCodeLinesCanvas" ClipToBounds="False"/>
                    <Canvas x:Name="LiveCodeDoodleCanvas" ClipToBounds="False"/>

                    <Canvas x:Name="LiveCodeCaretCanvas" ClipToBounds="False">
                        <Rectangle x:Name="LiveCodeCaretBlock" Width="3.5" Height="40" Fill="#F4F4F5"/>
                        <Border x:Name="LiveCodeArtistPill" CornerRadius="4" Padding="7,3" Background="#52525B">
                            <TextBlock x:Name="LiveCodeArtistText" Text="artist" FontSize="12" FontWeight="Bold"
                                       FontFamily="JetBrains Mono, Cascadia Mono, Consolas, monospace" Foreground="#FFFFFF"/>
                        </Border>
                    </Canvas>
                </Canvas>
            </Canvas>

            <Border x:Name="LiveCodeFindPill" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,76,40,0"
                    CornerRadius="8" Background="#D00E1016" BorderBrush="#30FFFFFF" BorderThickness="1"
                    Padding="14,6" Opacity="0">
                <TextBlock x:Name="LiveCodeFindText" Text="Find: Track Title   0 lines" FontSize="11"
                           FontFamily="JetBrains Mono, Cascadia Mono, Consolas, monospace" Foreground="#A1A1AA"/>
            </Border>
        </Grid>


        <!-- Kinetic track intro: shown briefly on track change -->
        <Grid x:Name="IntroHeroCard" HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="5"
              IsHitTestVisible="False" Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="IntroHeroScale" ScaleX="1.0" ScaleY="1.0"/>
                    <TranslateTransform x:Name="IntroHeroTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Grid.RenderTransform>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <TextBlock x:Name="IntroHeroTitle" FontSize="62" FontWeight="SemiBold"
                           FontFamily="Inter, Segoe UI Variable Display, Segoe UI"
                           Foreground="{StaticResource ChromeTextBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="920" HorizontalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#E4E4E7" Opacity="0.35"/>
                    </TextBlock.Effect>
                </TextBlock>
                <Border x:Name="IntroHeroArtistPill" CornerRadius="18" Background="#E60E1016" BorderBrush="#1AFFFFFF" BorderThickness="1"
                        Padding="20,8" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <TextBlock x:Name="IntroHeroArtist" FontSize="13" FontWeight="SemiBold" FontFamily="Inter, Segoe UI Variable Text, Segoe UI"
                               Foreground="#D4D4D8" TextAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Kinetic track badge, bottom left -->
        <Border x:Name="KineticCornerBadge" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="36,0,0,32" CornerRadius="18" Background="#D50E1016" BorderBrush="#35FFFFFF"
                BorderThickness="1" Padding="12,10" Panel.ZIndex="6" Visibility="Collapsed" Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="3" Color="#000000" Opacity="0.55"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Album Art Thumbnail -->
                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="10" Background="#0E1016" Margin="0,0,12,0">
                    <Grid>
                        <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                              Fill="#71717A" Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="KineticCornerImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Clip>
                                <RectangleGeometry RadiusX="10" RadiusY="10" Rect="0,0,44,44"/>
                            </Image.Clip>
                        </Image>
                    </Grid>
                </Border>

                <!-- Track Meta & Mini Progress Bar -->
                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock x:Name="KineticCornerTitle" Text="Track Title" FontSize="13" FontWeight="Bold"
                               Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                    <TextBlock x:Name="KineticCornerArtist" Text="Artist Name" FontSize="11" FontWeight="Medium"
                               Foreground="#A1A1AA" TextTrimming="CharacterEllipsis" MaxWidth="220" Margin="0,2,0,0"/>

                    <!-- Slim Mini Progress Bar -->
                    <Border Width="190" Height="4" CornerRadius="2" Background="#26FFFFFF" Margin="0,6,0,0">
                        <Grid HorizontalAlignment="Left" x:Name="KineticCornerProgressFill" Width="0">
                            <Border x:Name="KineticCornerProgressBarBorder" CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush x:Name="KineticCornerProgressGradient" StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop x:Name="KineticCornerStop0" Color="#A1A1AA" Offset="0.0"/>
                                        <GradientStop x:Name="KineticCornerStop1" Color="#FFFFFF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Vibe toolbar and window buttons. Auto-hides after 2.5s of no mouse movement. -->
        <Grid x:Name="TopChrome" SizeChanged="OnTopChromeSizeChanged" VerticalAlignment="Top" Margin="12,8,10,0" Opacity="0" Panel.ZIndex="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Column="1" CornerRadius="14" Background="#CC0E1016" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="4"
                    VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="BtnWinFullscreen" Style="{StaticResource WindowControlButton}" Click="OnWinFullscreenClicked">
                        <Path x:Name="GlyphFullscreen" Width="11" Height="11" Stretch="Uniform" StrokeThickness="1.3"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="BtnWinMinimize" Style="{StaticResource WindowControlButton}" Click="OnWinMinimizeClicked" ToolTip="Minimize">
                        <Path Data="M0,0 L10,0" Width="11" Stretch="Uniform" StrokeThickness="1.3"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="BtnWinMaximize" Style="{StaticResource WindowControlButton}" Click="OnWinMaximizeClicked">
                        <Path x:Name="GlyphMaximize" Width="11" Height="11" Stretch="Uniform" StrokeThickness="1.3"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="BtnWinClose" Style="{StaticResource WindowControlButton}" Click="OnExitClicked" ToolTip="Close (Alt+F4)">
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Width="11" Height="11" Stretch="Uniform" StrokeThickness="1.3"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="TopModeBar" WindowChrome.IsHitTestVisibleInChrome="True" HorizontalAlignment="Right" VerticalAlignment="Top"
                    CornerRadius="16" Background="#CC0E1016" BorderBrush="#35FFFFFF" BorderThickness="1"
                    Padding="12,6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="2" Color="#000000" Opacity="0.5"/>
                </Border.Effect>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="VIBE MODE" FontSize="10" FontWeight="Bold" Foreground="#F4F4F5" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="BtnToggleLayoutMode" Content="Mode: Split" Style="{StaticResource PillBarButton}" Focusable="False"
                            Margin="0,2,8,2" ToolTip="Toggle Split | Kinetic Mode (K)" ToolTipService.Placement="Top" ToolTipService.InitialShowDelay="1200"/>
                    <Button x:Name="BtnToggleKineticPreset" Content="Style: Moonlight Bloom" Style="{StaticResource PillBarButton}" Focusable="False"
                            Margin="0,2,8,2"/>
                    <StackPanel x:Name="KineticControlsPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,8,0">
                        <Button x:Name="BtnToggleSpotlightBackdrop" Content="Backdrop: HD Art" Style="{StaticResource PillBarButton}"
                                Margin="0,2,8,2" Click="OnToggleSpotlightBackdropClicked" ToolTip="Toggle Spotlight Backdrop (HD Cover | Fluid Color)"/>
                        <Button x:Name="BtnTogglePosterDim" Content="Tone: Dim" Style="{StaticResource PillBarButton}"
                                Margin="0,2,8,2" Click="OnTogglePosterDimClicked" ToolTip="Toggle Poster Night-Safe Dim Mode (Dim | Vivid)"/>
                        <Button x:Name="BtnToggleVibe" Content="Vibe: Auto" Style="{StaticResource PillBarButton}" Focusable="False" Margin="0,2,0,2"/>
                    </StackPanel>
                    <Button x:Name="BtnToggleFisheye" Content="Fisheye: OFF" Style="{StaticResource PillBarButton}" Visibility="Collapsed"
                            Margin="0,2,8,2" Click="OnToggleFisheyeClicked" ToolTip="Wide-angle lens for Moonlight Bloom"/>
                    <Button x:Name="BtnToggleAudioReactive" Content="Audio Reactive: ON" Style="{StaticResource PillBarButton}"
                            Margin="0,2,8,2" Click="OnToggleAudioReactiveClicked"/>
                    <Button x:Name="BtnToggleThemeLyrics" Content="Theme Lyrics: ON" Style="{StaticResource PillBarButton}"
                            Margin="0,2,8,2" Click="OnToggleThemeLyricsClicked" ToolTip="Toggle Album-Themed Lyric Colors"/>
                </WrapPanel>
            </Border>
        </Grid>

        <!-- Hairline frame while windowed -->
        <Border x:Name="WindowHairline" BorderBrush="#1AFFFFFF" BorderThickness="1" IsHitTestVisible="False" Panel.ZIndex="50"/>

        <!-- Ambient Idle: shown while paused -->
        <Grid x:Name="AmbientHost" Panel.ZIndex="8" Background="#050608" Visibility="Collapsed" Opacity="0">
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.46" GradientOrigin="0.5,0.46" RadiusX="0.6" RadiusY="0.55">
                        <GradientStop Color="#1AFFFFFF" Offset="0.0"/>
                        <GradientStop Color="#0AFFFFFF" Offset="0.45"/>
                        <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Canvas x:Name="AmbientDustCanvas" ClipToBounds="True" IsHitTestVisible="False"/>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,36" IsHitTestVisible="False">
                <Grid HorizontalAlignment="Center">
                    <!-- Bloom is cached: the text only changes once a minute -->
                    <Border Padding="50,30" Margin="-50,-30">
                        <Border.CacheMode>
                            <BitmapCache RenderAtScale="0.5"/>
                        </Border.CacheMode>
                        <TextBlock x:Name="AmbientClockGlow" FontFamily="Arial Rounded MT Bold, Arial Rounded MT, Segoe UI Black, Segoe UI" FontWeight="Black"
                                   FontSize="200" Foreground="#E4E4E7" Opacity="0.75">
                            <TextBlock.Effect>
                                <BlurEffect x:Name="AmbientGlowEffect" Radius="30"/>
                            </TextBlock.Effect>
                        </TextBlock>
                    </Border>
                    <TextBlock x:Name="AmbientClockText" FontFamily="Arial Rounded MT Bold, Arial Rounded MT, Segoe UI Black, Segoe UI" FontWeight="Black"
                               FontSize="200" Foreground="#FFFFFF"/>
                </Grid>
                <TextBlock x:Name="AmbientDateText" FontSize="22" Foreground="#A1A1AA" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>

            <Border x:Name="AmbientPausedPill" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="16,0,16,36" CornerRadius="16"
                    Background="#0E1016" BorderBrush="#14FFFFFF" BorderThickness="1" Padding="16,7" Cursor="Hand" ToolTip="Resume"
                    MouseLeftButtonUp="OnAmbientPausedPillClicked">
                <TextBlock x:Name="AmbientPausedText" FontSize="12" Foreground="#A1A1AA" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>

        <!-- Dynamic Word Pacing notice, shown on every entry into Kinetic mode -->
        <Grid x:Name="PacingPill" Panel.ZIndex="9" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,34"
              Visibility="Collapsed" Opacity="0" Focusable="False" Cursor="Hand" RenderTransformOrigin="0.5,0.5"
              MouseLeftButtonDown="OnPacingPillClicked">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PacingScale"/>
                    <TranslateTransform x:Name="PacingTranslate"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- Glass surface, chrome rim and silver glow -->
            <Border CornerRadius="28" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#EB111218" Offset="0.0"/>
                        <GradientStop Color="#EB0E1016" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#38FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#14FFFFFF" Offset="0.55"/>
                        <GradientStop Color="#14FFFFFF" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#E4E4E7" Opacity="0.22"/>
                </Border.Effect>
            </Border>

            <!-- Everything in here is clipped to the rounded shape (see OnPacingClipSizeChanged) -->
            <Grid x:Name="PacingClip" Margin="1" SizeChanged="OnPacingClipSizeChanged">
                <StackPanel Orientation="Horizontal" Margin="20,10,16,11">
                    <Path Data="M 0,-1 Q 0.1,-0.1 1,0 Q 0.1,0.1 0,1 Q -0.1,0.1 -1,0 Q -0.1,-0.1 0,-1 Z" Stretch="Uniform"
                          Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,14,0" RenderTransformOrigin="0.5,0.5"
                          Fill="{StaticResource ChromeFillBrush}">
                        <Path.RenderTransform>
                            <ScaleTransform x:Name="PacingIconScale"/>
                        </Path.RenderTransform>
                        <Path.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#FFFFFF" Opacity="0.75"/>
                        </Path.Effect>
                    </Path>
                    <StackPanel VerticalAlignment="Center">
                        <!-- Glow on its own layer so the title itself stays crisp -->
                        <Grid HorizontalAlignment="Left">
                            <TextBlock Text="Dynamic Word Pacing" FontSize="13.5" FontWeight="SemiBold" Foreground="#FFFFFF" Opacity="0.35">
                                <TextBlock.Effect>
                                    <BlurEffect Radius="7"/>
                                </TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="Dynamic Word Pacing" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource ChromeTextBrush}"/>
                        </Grid>
                        <TextBlock x:Name="PacingSubtext" Text="Timing adapts automatically for tracks that only provide line-level lyrics." FontSize="11.5"
                                   Foreground="#A1A1AA" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border Width="1" Background="#1AFFFFFF" Margin="18,4,8,4"/>
                    <Button x:Name="BtnPacingDontShow" Content="Don't show again" Style="{StaticResource PacingMicroButton}"
                            VerticalAlignment="Center" Click="OnPacingDontShowClicked"/>
                </StackPanel>

                <!-- Diagonal glint -->
                <Rectangle x:Name="PacingSheen" Width="110" HorizontalAlignment="Left" IsHitTestVisible="False" Opacity="0">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0.0"/>
                            <GradientStop Color="#0FE4E4E7" Offset="0.3"/>
                            <GradientStop Color="#3DFFFFFF" Offset="0.5"/>
                            <GradientStop Color="#0FE4E4E7" Offset="0.7"/>
                            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <TransformGroup>
                            <SkewTransform AngleX="-24"/>
                            <TranslateTransform x:Name="PacingSheenTranslate" X="-160"/>
                        </TransformGroup>
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!-- Auto-dismiss hairline -->
                <Border Height="1.5" VerticalAlignment="Bottom" IsHitTestVisible="False" RenderTransformOrigin="0,0.5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#52525B" Offset="0.0"/>
                            <GradientStop Color="#F4F4F5" Offset="0.5"/>
                            <GradientStop Color="#FFFFFF" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="PacingProgressScale"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#FFFFFF" Opacity="0.6"/>
                    </Border.Effect>
                </Border>
            </Grid>
        </Grid>

        <!-- Hover dropdown shared by the Mode / Style / Vibe pills. The transparent top strip bridges the gap to the pill. -->
        <Canvas x:Name="HoverMenuOverlay" Panel.ZIndex="11">
            <Border x:Name="HoverMenu" WindowChrome.IsHitTestVisibleInChrome="True" Visibility="Collapsed"
                    Background="Transparent" Padding="0,6,0,0">
                <Grid>
                    <Border CornerRadius="12" Background="#07080B">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" Direction="270" ShadowDepth="3" Color="#000000" Opacity="0.6"/>
                        </Border.Effect>
                    </Border>
                    <Border CornerRadius="12" Background="#07080B" BorderBrush="#1AFFFFFF" BorderThickness="1" Padding="5">
                        <StackPanel x:Name="HoverMenuItems" MinWidth="150"/>
                    </Border>
                </Grid>
            </Border>
        </Canvas>
    </Grid>
</Window>
