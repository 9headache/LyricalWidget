<Window x:Class="LyricalWidget.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:LyricalWidget.Common"
        Title="Getting Started - LyricalWidget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Inter, Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="JetBrains Mono, Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#71717A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="ItemTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="ItemText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#111218"/>
            <Setter Property="BorderBrush" Value="#1CFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="0,1,10,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="MinWidth" Value="84"/>
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <!-- Shadow on its own layer so text is not rasterized by the effect -->
        <Border CornerRadius="20" Background="#07080B">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" Direction="270" ShadowDepth="4" Color="#000000" Opacity="0.75"/>
            </Border.Effect>
        </Border>

        <Border x:Name="Card" CornerRadius="20" Width="520" Background="#07080B" BorderBrush="#17FFFFFF" BorderThickness="1">
            <Grid>
                <Border VerticalAlignment="Top" Height="1" Margin="24,0,24,0" Background="{StaticResource ChromeSheenBrush}"/>

                <StackPanel Margin="24,24,24,22">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Width="44" Height="44" CornerRadius="12" Background="#0E1016"
                                BorderBrush="#17FFFFFF" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Image x:Name="ImgIcon" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Margin="5"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Getting Started" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ChromeTextBrush}"/>
                                <Border CornerRadius="9" Background="#111218" BorderBrush="#1CFFFFFF" BorderThickness="1"
                                        Padding="8,2" Margin="10,3,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static common:AppVersionInfo.VersionTag}" FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                               FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource ChromeTextBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="The essentials, in one place." FontSize="12" Foreground="#A1A1AA" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Controls -->
                    <Border CornerRadius="14" Background="#0E1016" BorderBrush="#17FFFFFF" BorderThickness="1" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="CONTROLS" Style="{StaticResource SectionLabel}"/>

                            <DockPanel Margin="0,0,0,10">
                                <Border DockPanel.Dock="Left" Style="{StaticResource KeyCap}">
                                    <TextBlock Text="Quick Access" FontSize="10.5" FontWeight="SemiBold" Foreground="#E4E4E7" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Themes, layout and presets" Style="{StaticResource ItemTitle}"/>
                                    <TextBlock Text="The menu above the widget while it is unlocked. The tray icon's right-click menu has the same options." Style="{StaticResource ItemText}"/>
                                </StackPanel>
                            </DockPanel>

                            <DockPanel Margin="0,0,0,10">
                                <Border DockPanel.Dock="Left" Style="{StaticResource KeyCap}">
                                    <TextBlock x:Name="TxtLockKey" Text="Alt + L" FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="10.5" Foreground="#E4E4E7" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Lock for gaming" Style="{StaticResource ItemTitle}"/>
                                    <TextBlock Text="Locks the widget so clicks go straight through to your game. Press again to unlock and move it." Style="{StaticResource ItemText}"/>
                                </StackPanel>
                            </DockPanel>

                            <DockPanel>
                                <Border DockPanel.Dock="Left" Style="{StaticResource KeyCap}">
                                    <TextBlock Text="Alt + F" FontFamily="JetBrains Mono, Cascadia Mono, Consolas" FontSize="10.5" Foreground="#E4E4E7" HorizontalAlignment="Center"/>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Vibe Mode" Style="{StaticResource ItemTitle}"/>
                                    <TextBlock Text="Opens the big-screen visualizer in a window you can snap and resize. F11 goes fullscreen, Esc returns to the window." Style="{StaticResource ItemText}"/>
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Kinetic and Vibe styles -->
                    <Border CornerRadius="14" Background="#0E1016" BorderBrush="#17FFFFFF" BorderThickness="1" Padding="16,14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="KINETIC &amp; VIBE STYLES" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Style="{StaticResource ItemText}" Margin="0,0,0,10" Foreground="#D4D4D8">
                                Kinetic mode sets each line word by word as it is sung, and the motion reacts to the beat.
                            </TextBlock>

                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="Moonlight Bloom" Style="{StaticResource ItemTitle}"/>
                                    <TextBlock Text="Glowing words, on a black card or straight over your desktop." Style="{StaticResource ItemText}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Fisheye" Style="{StaticResource ItemTitle}"/>
                                    <TextBlock Text="A GPU wide-angle lens over Moonlight Bloom." Style="{StaticResource ItemText}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,10">
                                    <TextBlock Text="Live Code" Style="{StaticResource ItemTitle}"/>
                                    <TextBlock Text="Lyrics typed out as syntax-highlighted code." Style="{StaticResource ItemText}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="Spotlight Fog" Style="{StaticResource ItemTitle}"/>
                                    <TextBlock Text="One word at a time, rolling through soft fog." Style="{StaticResource ItemText}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Text="Split Mode" Style="{StaticResource ItemTitle}"/>
                                    <TextBlock Text="Album art beside a scrolling lyric sheet." Style="{StaticResource ItemText}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Ambient Idle" Style="{StaticResource ItemTitle}"/>
                                    <TextBlock Text="Pause the music and Vibe Mode fades to a glowing clock." Style="{StaticResource ItemText}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button x:Name="BtnNotRequired" Content="Not required" Style="{StaticResource ChromeSecondaryButton}" Margin="0,0,10,0"
                                IsCancel="True" Click="OnNotRequiredClicked"/>
                        <Button x:Name="BtnThanks" Content="Got it, thanks" Style="{StaticResource ChromePrimaryButton}"
                                IsDefault="True" Click="OnThanksClicked"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
