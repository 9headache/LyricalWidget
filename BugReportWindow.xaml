<Window x:Class="LyricalWidget.BugReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report a Bug - LyricalWidget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <LinearGradientBrush x:Key="TopSheenBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00FFFFFF" Offset="0.0"/>
            <GradientStop Color="#55FFFFFF" Offset="0.5"/>
            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SpecularGlassBorder" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#70FFFFFF" Offset="0.0"/>
            <GradientStop Color="#4038BDF8" Offset="0.45"/>
            <GradientStop Color="#18FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="14" Background="#1FFFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1">
                            <TextBlock Text="✕" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FF3B6B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#80FF3B6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border CornerRadius="24" ClipToBounds="True" Background="#E60B0E14"
                BorderBrush="{StaticResource SpecularGlassBorder}" BorderThickness="1" Width="520">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" Direction="270" ShadowDepth="4" Color="#000000" Opacity="0.75"/>
            </Border.Effect>

            <Grid Margin="24,20,24,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Separator -->
                    <RowDefinition Height="Auto"/> <!-- Issue Description -->
                    <RowDefinition Height="Auto"/> <!-- Diagnostics -->
                    <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                </Grid.RowDefinitions>

                <!-- Top Sheen Highlight -->
                <Border VerticalAlignment="Top" Height="1.5" Margin="0,-20,0,0" Background="{StaticResource TopSheenBrush}" CornerRadius="1"/>

                <!-- Row 0: Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Report an Issue" FontSize="17" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <Border CornerRadius="6" Background="#26FF3B6B" BorderBrush="#80FF3B6B" BorderThickness="1"
                                    Padding="6,1.5" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v2.0.002" FontSize="10" FontWeight="Bold" Foreground="#FF3B6B"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Report bugs &amp; feature requests on GitHub: github.com/9headache/LyricalWidget" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource CloseButtonStyle}" Click="OnCloseClicked" VerticalAlignment="Top"/>
                </Grid>

                <!-- Row 1: Separator -->
                <Border Grid.Row="1" Height="1" Background="#1AFFFFFF" Margin="0,14,0,14"/>

                <!-- Row 2: User Description Input -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="DESCRIBE WHAT HAPPENED" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="1,0,0,6"/>
                    <TextBox x:Name="TxtDescription" Height="90" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" Background="#161924" Foreground="#F8FAFC"
                             BorderBrush="#3338BDF8" BorderThickness="1" Padding="10" FontSize="12"
                             FontFamily="Segoe UI" SelectionBrush="#38BDF8" CaretBrush="#38BDF8">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <!-- Row 3: Auto-attached Diagnostics -->
                <StackPanel Grid.Row="3" Margin="0,14,0,0">
                    <TextBlock Text="ATTACHED DIAGNOSTICS (READ-ONLY)" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="1,0,0,6"/>
                    <TextBox x:Name="TxtDiagnostics" Height="100" TextWrapping="Wrap" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" Background="#0F111A" Foreground="#CBD5E1"
                             BorderBrush="#20FFFFFF" BorderThickness="1" Padding="8" FontSize="10.5"
                             FontFamily="Consolas, Segoe UI">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <!-- Row 4: Action Buttons -->
                <Grid Grid.Row="4" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="1.0*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Button 1: Open on GitHub (Primary) -->
                    <Button Grid.Column="0" Margin="0,0,8,0" Height="34" Cursor="Hand" Click="OnOpenGitHubClicked">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="10" Background="#3538BDF8" BorderBrush="#38BDF8" BorderThickness="1">
                                    <TextBlock Text="Open GitHub Issues" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#5538BDF8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Button 2: Copy Report -->
                    <Button x:Name="BtnCopyReport" Grid.Column="1" Height="34" Cursor="Hand" Click="OnCopyReportClicked">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="10" Background="#1E2335" BorderBrush="#33FFFFFF" BorderThickness="1">
                                    <TextBlock x:Name="TxtCopyBtn" Text="Copy Report" FontSize="11.5" FontWeight="SemiBold" Foreground="#E2E8F0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#302D45"/>
                                        <Setter TargetName="b" Property="BorderBrush" Value="#66FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
