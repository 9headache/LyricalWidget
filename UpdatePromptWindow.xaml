<Window x:Class="LyricalWidget.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Available - LyricalWidget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Inter, Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <Style x:Key="ChromeProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="4" Background="#181A22" BorderBrush="#17FFFFFF" BorderThickness="1"/>
                            <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#52525B" Offset="0.0"/>
                                        <GradientStop Color="#A1A1AA" Offset="0.45"/>
                                        <GradientStop Color="#F4F4F5" Offset="0.8"/>
                                        <GradientStop Color="#FFFFFF" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StageText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#71717A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="StageMark" TargetType="TextBlock">
            <Setter Property="Width" Value="22"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#71717A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <!-- Shadow on its own layer so text is not rasterized by the effect -->
        <Border CornerRadius="20" Background="#07080B">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" Direction="270" ShadowDepth="4" Color="#000000" Opacity="0.75"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="20" Width="460" Background="#07080B" BorderBrush="#1CFFFFFF" BorderThickness="1">
            <Grid>
                <Border VerticalAlignment="Top" Height="1" Margin="24,0,24,0" Background="{StaticResource ChromeSheenBrush}"/>

                <Grid Margin="24,22,24,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="184"/>  <!-- Notes / Progress / Error -->
                        <RowDefinition Height="Auto"/> <!-- Actions -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TxtHeading" Text="Update available" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource ChromeTextBrush}"/>
                            <Border CornerRadius="9" Background="#111218" BorderBrush="#1CFFFFFF" BorderThickness="1"
                                    Padding="8,2" Margin="0,8,0,0" HorizontalAlignment="Left">
                                <TextBlock x:Name="TxtVersionCompare" FontFamily="JetBrains Mono, Cascadia Mono, Consolas"
                                           FontSize="11" FontWeight="SemiBold" Foreground="#D4D4D8"/>
                            </Border>
                        </StackPanel>

                        <Button x:Name="BtnClose" Grid.Column="1" Style="{StaticResource ChromeCloseButton}" Click="OnCloseClicked" VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Row 1a: Release Notes -->
                    <DockPanel x:Name="NotesPanel" Grid.Row="1">
                        <TextBlock DockPanel.Dock="Top" Text="Release notes" FontSize="11.5" FontWeight="SemiBold" Foreground="#A1A1AA" Margin="2,0,0,8"/>
                        <TextBox x:Name="TxtReleaseNotes" Style="{StaticResource ChromeTextBox}" TextWrapping="Wrap" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto" Padding="10" FontSize="12"/>
                    </DockPanel>

                    <!-- Row 1b: Live Progress -->
                    <Border x:Name="ProgressPanel" Grid.Row="1" Visibility="Collapsed" CornerRadius="14" Padding="18,0"
                            Background="#0E1016" BorderBrush="#17FFFFFF" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStatus" Text="Downloading update..." FontSize="12.5" FontWeight="SemiBold" Foreground="#E4E4E7"
                                       AutomationProperties.LiveSetting="Polite" Margin="0,0,0,10"/>
                            <ProgressBar x:Name="BarProgress" Style="{StaticResource ChromeProgressBar}" AutomationProperties.Name="Update progress"/>

                            <StackPanel Margin="0,18,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="MarkDownload" Style="{StaticResource StageMark}"/>
                                    <TextBlock x:Name="StageDownload" Text="Download update" Style="{StaticResource StageText}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock x:Name="MarkPrepare" Style="{StaticResource StageMark}"/>
                                    <TextBlock x:Name="StagePrepare" Text="Extract &amp; prepare" Style="{StaticResource StageText}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock x:Name="MarkRestart" Style="{StaticResource StageMark}"/>
                                    <TextBlock x:Name="StageRestart" Text="Restart LyricalWidget" Style="{StaticResource StageText}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Row 1c: Error -->
                    <Border x:Name="ErrorPanel" Grid.Row="1" Visibility="Collapsed" CornerRadius="14" Padding="18,0"
                            Background="#0E1016" BorderBrush="#17FFFFFF" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtErrorMessage" FontSize="12.5" Foreground="#E4E4E7" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" MaxHeight="90" AutomationProperties.LiveSetting="Assertive"/>
                            <TextBlock Text="Your current version was not changed." FontSize="11.5" Foreground="#A1A1AA" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Row 2: Actions -->
                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnGitHub" Grid.Column="0" Content="View on GitHub" Style="{StaticResource ChromeSecondaryButton}" Click="OnViewOnGitHubClicked"/>
                        <Button x:Name="BtnLater" Grid.Column="2" Content="Later" Style="{StaticResource ChromeSecondaryButton}" Click="OnCloseClicked"/>
                        <Button x:Name="BtnUpdate" Grid.Column="3" Content="Update Now" Style="{StaticResource ChromePrimaryButton}" Margin="8,0,0,0" Click="OnUpdateNowClicked"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
