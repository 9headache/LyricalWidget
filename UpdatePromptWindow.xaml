<Window x:Class="LyricalWidget.UpdatePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Available - LyricalWidget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <LinearGradientBrush x:Key="SpecularGlassBorder" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#70FFFFFF" Offset="0.0"/>
            <GradientStop Color="#4038BDF8" Offset="0.45"/>
            <GradientStop Color="#18FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="14" Background="#1FFFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1">
                            <TextBlock Text="✕" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FF3B6B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#80FF3B6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Border CornerRadius="16" Width="440" Background="#121520" BorderBrush="{StaticResource SpecularGlassBorder}" BorderThickness="1.5">
            <Grid Margin="22,18,22,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Separator -->
                    <RowDefinition Height="Auto"/> <!-- Release Notes -->
                    <RowDefinition Height="Auto"/> <!-- Status -->
                    <RowDefinition Height="Auto"/> <!-- Actions -->
                </Grid.RowDefinitions>

                <!-- Row 0: Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="NEW VERSION AVAILABLE" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtVersionCompare" Text="v2.0.002 → v2.0.003" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <Border CornerRadius="6" Background="#2638BDF8" BorderBrush="#8038BDF8" BorderThickness="1"
                                    Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="UPDATE READY" FontSize="9.5" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Style="{StaticResource CloseButtonStyle}" Click="OnCloseClicked" VerticalAlignment="Top"/>
                </Grid>

                <!-- Row 1: Separator -->
                <Border Grid.Row="1" Height="1" Background="#1AFFFFFF" Margin="0,14,0,14"/>

                <!-- Row 2: Release Notes -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="RELEASE NOTES" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="1,0,0,6"/>
                    <TextBox x:Name="TxtReleaseNotes" Height="140" TextWrapping="Wrap" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" Background="#161924" Foreground="#F8FAFC"
                             BorderBrush="#3338BDF8" BorderThickness="1" Padding="10" FontSize="12"
                             FontFamily="Segoe UI" SelectionBrush="#38BDF8" CaretBrush="#38BDF8">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>

                <!-- Row 3: Status Message -->
                <TextBlock x:Name="TxtStatus" Grid.Row="3" Margin="0,10,0,0" Text="" FontSize="11" Foreground="#38BDF8"
                           HorizontalAlignment="Center" Visibility="Collapsed"/>

                <!-- Row 4: Action Buttons -->
                <Grid Grid.Row="4" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="0.8*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Button 1: Update & Restart (Primary) -->
                    <Button x:Name="BtnUpdate" Grid.Column="0" Margin="0,0,6,0" Height="34" Cursor="Hand" Click="OnUpdateAndRestartClicked">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="10" Background="#3538BDF8" BorderBrush="#38BDF8" BorderThickness="1">
                                    <TextBlock x:Name="TxtBtn" Text="Update &amp; Restart" FontSize="11.5" FontWeight="Bold" Foreground="#38BDF8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#5538BDF8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Button 2: View on GitHub -->
                    <Button x:Name="BtnGitHub" Grid.Column="1" Margin="0,0,6,0" Height="34" Cursor="Hand" Click="OnViewOnGitHubClicked">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="10" Background="#1E2335" BorderBrush="#33FFFFFF" BorderThickness="1">
                                    <TextBlock Text="View on GitHub" FontSize="11.5" FontWeight="SemiBold" Foreground="#E2E8F0"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#302D45"/>
                                        <Setter TargetName="b" Property="BorderBrush" Value="#66FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Button 3: Later -->
                    <Button x:Name="BtnLater" Grid.Column="2" Height="34" Cursor="Hand" Click="OnCloseClicked">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="10" Background="#1E2335" BorderBrush="#33FFFFFF" BorderThickness="1">
                                    <TextBlock Text="Later" FontSize="11.5" FontWeight="SemiBold" Foreground="#94A3B8"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="#302D45"/>
                                        <Setter TargetName="b" Property="BorderBrush" Value="#66FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
