<Window x:Class="LyricalWidget.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:LyricalWidget.Common"
        Title="Welcome to LyricalWidget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Inter, Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
        <FontFamily x:Key="MonoFont">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

        <!-- Brushed chrome: the dark stop sits past the edge so text stays readable -->
        <LinearGradientBrush x:Key="ChromeBrush" StartPoint="0,0" EndPoint="1,0.6">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#A1A1AA" Offset="0.45"/>
            <GradientStop Color="#F4F4F5" Offset="0.8"/>
            <GradientStop Color="#52525B" Offset="1.5"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ChromeButtonBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0.0"/>
            <GradientStop Color="#D4D4D8" Offset="0.55"/>
            <GradientStop Color="#A1A1AA" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="TopSheenBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00FFFFFF" Offset="0.0"/>
            <GradientStop Color="#66FFFFFF" Offset="0.5"/>
            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <Style x:Key="KeycapBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1E2029" Offset="0.0"/>
                        <GradientStop Color="#111218" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#1CFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="KeycapText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F4F4F5"/>
        </Style>

        <Style x:Key="TipRow" TargetType="Border">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderBrush" Value="#17FFFFFF"/>
        </Style>

        <Style x:Key="TipCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#0E1016"/>
            <Setter Property="BorderBrush" Value="#17FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="14" Background="#0E1016" BorderBrush="#17FFFFFF" BorderThickness="1">
                            <TextBlock x:Name="glyph" Text="✕" FontSize="11" Foreground="#A1A1AA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#181A22"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#38FFFFFF"/>
                                <Setter TargetName="glyph" Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootContainer" Margin="32">
        <!-- Animated host: the shadow lives on its own layer so text is not rasterized by the effect -->
        <Grid x:Name="CardHost" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="1.0" ScaleY="1.0"/>
                    <TranslateTransform x:Name="CardTranslate" Y="0"/>
                </TransformGroup>
            </Grid.RenderTransform>

            <Border CornerRadius="20" Background="#07080B">
                <Border.Effect>
                    <DropShadowEffect x:Name="CardShadow" BlurRadius="32" Direction="270" ShadowDepth="4" Color="#000000" Opacity="0.75"/>
                </Border.Effect>
            </Border>

            <Border x:Name="CardBorder" CornerRadius="20" Background="#07080B" BorderBrush="#1CFFFFFF" BorderThickness="1"/>

            <Grid>
                <!-- Top Sheen Highlight -->
                <Border VerticalAlignment="Top" Height="1" Margin="24,0,24,0" Background="{StaticResource TopSheenBrush}"/>

                <!-- ========================================== -->
                <!-- 1. FULL FIRST-BOOT GUIDE (Interactive)     -->
                <!-- ========================================== -->
                <Grid x:Name="FullGuideCard" Visibility="Visible" Width="520" Margin="26,24,26,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Tips -->
                        <RowDefinition Height="Auto"/> <!-- Footer -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="12" Background="#0E1016"
                                BorderBrush="#17FFFFFF" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Image x:Name="ImgFullIcon" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Margin="5"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="LyricalWidget" FontSize="22" FontWeight="Bold" Foreground="{StaticResource ChromeBrush}"/>

                                <!-- Version pill (AppVersionInfo) -->
                                <Border CornerRadius="9" Background="#111218" BorderBrush="#1CFFFFFF" BorderThickness="1"
                                        Padding="8,2" Margin="10,2,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static common:AppVersionInfo.VersionTag}" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                                               FontWeight="SemiBold" Foreground="{StaticResource ChromeBrush}"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="Made with love by 9headache" FontSize="11.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="2" Style="{StaticResource CloseButtonStyle}" Click="OnCloseClicked" VerticalAlignment="Top"/>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Vertical">
                        <TextBlock Text="Shortcuts" Style="{StaticResource SectionLabel}"/>
                        <Border Style="{StaticResource TipCard}">
                            <StackPanel>
                                <Border Style="{StaticResource TipRow}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="116"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource KeycapBadge}">
                                            <TextBlock Text="Alt + L" Style="{StaticResource KeycapText}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Lock / unlock overlay" FontSize="12.5" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                            <TextBlock Text="Drag anywhere, resize and change the look" FontSize="11.5" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource TipRow}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="116"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource KeycapBadge}">
                                            <TextBlock Text="Alt + H" Style="{StaticResource KeycapText}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Hide / show" FontSize="12.5" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                            <TextBlock Text="Toggle overlay visibility on the fly" FontSize="11.5" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource TipRow}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="116"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource KeycapBadge}">
                                            <TextBlock Text="Alt + F" Style="{StaticResource KeycapText}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Fullscreen Vibe Mode" FontSize="12.5" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                            <TextBlock Text="Album controls, volume bar and Kinetic Mode (Beta) via K" FontSize="11.5" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource TipRow}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="116"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource KeycapBadge}">
                                            <TextBlock Text="Alt + R" Style="{StaticResource KeycapText}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Refresh lyrics" FontSize="12.5" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                            <TextBlock Text="Re-sync the player and fetch this song again" FontSize="11.5" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource TipRow}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="116"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource KeycapBadge}">
                                            <TextBlock Text="Alt + [ / ]" Style="{StaticResource KeycapText}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Nudge lyrics sync" FontSize="12.5" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                            <TextBlock Text="Shift timing by 100 ms, saved per song" FontSize="11.5" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Good to know" Style="{StaticResource SectionLabel}" Margin="2,16,0,8"/>
                        <Border Style="{StaticResource TipCard}">
                            <StackPanel>
                                <Border Style="{StaticResource TipRow}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="116"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource KeycapBadge}">
                                            <TextBlock Text="In-game" Style="{StaticResource KeycapText}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Use Borderless Windowed" FontSize="12.5" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                            <TextBlock Text="Required for overlays on top of fullscreen games" FontSize="11.5" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource TipRow}" BorderThickness="0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="116"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource KeycapBadge}">
                                            <TextBlock Text="System tray" Style="{StaticResource KeycapText}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Right-click the tray icon" FontSize="12.5" FontWeight="SemiBold" Foreground="#E4E4E7"/>
                                            <TextBlock Text="Settings, reset position, reopen this guide or report bugs" FontSize="11.5" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,20,0,0">
                        <TextBlock Text="Press Esc to close" FontSize="11.5" Foreground="#8B8B94" VerticalAlignment="Center" Margin="2,0,0,0"/>
                        <Button Content="Start Listening" Width="148" Height="36" Cursor="Hand" IsDefault="True"
                                HorizontalAlignment="Right" Click="OnCloseClicked">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" CornerRadius="18" Background="{StaticResource ChromeButtonBrush}">
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="SemiBold" Foreground="#07080B"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Grid>

                <!-- ========================================== -->
                <!-- 2. RETURNING QUICK SPLASH PILL (Compact)   -->
                <!-- ========================================== -->
                <Grid x:Name="QuickSplashCard" Visibility="Collapsed" Width="320" Margin="16,14,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#0E1016"
                            BorderBrush="#17FFFFFF" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Image x:Name="ImgSplashIcon" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Margin="4"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="LyricalWidget" FontSize="15" FontWeight="Bold" Foreground="{StaticResource ChromeBrush}"/>

                            <Border CornerRadius="9" Background="#111218" BorderBrush="#1CFFFFFF" BorderThickness="1"
                                        Padding="6,1" Margin="8,1,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static common:AppVersionInfo.VersionTag}" FontFamily="{StaticResource MonoFont}" FontSize="9.5"
                                               FontWeight="SemiBold" Foreground="{StaticResource ChromeBrush}"/>
                                </Border>
                        </StackPanel>

                        <TextBlock Text="Made with love by 9headache" FontSize="10.5" Foreground="#A1A1AA" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
