<Window x:Class="LyricalWidget.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to LyricalWidget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <!-- Top Edge Inner Sheen -->
        <LinearGradientBrush x:Key="TopSheenBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00FFFFFF" Offset="0.0"/>
            <GradientStop Color="#55FFFFFF" Offset="0.5"/>
            <GradientStop Color="#00FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Specular rim for Glassify Fluid Glass -->
        <LinearGradientBrush x:Key="SpecularGlassBorder" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#70FFFFFF" Offset="0.0"/>
            <GradientStop Color="#4038BDF8" Offset="0.45"/>
            <GradientStop Color="#18FFFFFF" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Keycap Pill Style -->
        <Style x:Key="KeycapBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#2A2F42"/>
            <Setter Property="BorderBrush" Value="#4D38BDF8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="14" Background="#1FFFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1">
                            <TextBlock Text="✕" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FF3B6B"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#80FF3B6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootContainer" Margin="20">
        <!-- Main Animated Card -->
        <Border x:Name="CardBorder" CornerRadius="24" ClipToBounds="True"
                Background="#E60B0E14" BorderBrush="{StaticResource SpecularGlassBorder}" BorderThickness="1"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" ScaleX="1.0" ScaleY="1.0"/>
                    <TranslateTransform x:Name="CardTranslate" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="CardShadow" BlurRadius="32" Direction="270" ShadowDepth="4" Color="#000000" Opacity="0.75"/>
            </Border.Effect>

            <Grid>
                <!-- Top Sheen Highlight -->
                <Border VerticalAlignment="Top" Height="1.5" Margin="24,0,24,0" Background="{StaticResource TopSheenBrush}" CornerRadius="1"/>

                <!-- ========================================== -->
                <!-- 1. FULL FIRST-BOOT GUIDE (Interactive)     -->
                <!-- ========================================== -->
                <Grid x:Name="FullGuideCard" Visibility="Visible" Width="520" Margin="26,22,26,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Separator -->
                        <RowDefinition Height="Auto"/> <!-- Tips List -->
                        <RowDefinition Height="Auto"/> <!-- Footer -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header with App Icon, Titles, Badges & Close Button -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- App Icon -->
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10" Background="#1F2332"
                                BorderBrush="#33FFFFFF" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Image x:Name="ImgFullIcon" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Margin="4"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="LyricalWidget" FontSize="19" FontWeight="Bold" Foreground="#F8FAFC"/>

                                <!-- Zero Two Rose-Crimson 002 Badge -->
                                <Border CornerRadius="8" Background="#26FF3B6B" BorderBrush="#80FF3B6B" BorderThickness="1"
                                        Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="v2.0.002" FontSize="10.5" FontWeight="Bold" Foreground="#FF3B6B"/>
                                        <TextBlock Text="•" FontSize="8.5" Foreground="#80FF3B6B" Margin="4,0,4,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="CODE: 002" FontSize="9.5" FontWeight="SemiBold" Foreground="#FF6B8B" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="Made with love by 9headache" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Close Button -->
                        <Button Grid.Column="2" Style="{StaticResource CloseButtonStyle}" Click="OnCloseClicked" VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Row 1: Subtle Specular Separator -->
                    <Border Grid.Row="1" Height="1" Background="#1FFFFFFF" Margin="0,16,0,16"/>

                    <!-- Row 2: Clean Scannable Modern Tips -->
                    <StackPanel Grid.Row="2" Orientation="Vertical">
                        <TextBlock Text="QUICK START &amp; IN-GAME TIPS" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="2,0,0,10"/>

                        <!-- Tip 1: Alt + L Unlock -->
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource KeycapBadge}" HorizontalAlignment="Left">
                                <TextBlock Text="Alt + L" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11.5" Foreground="#E2E8F0">
                                <Run FontWeight="SemiBold" Text="Unlock overlay"/>
                                <Run Foreground="#94A3B8" Text=" — drag anywhere, resize &amp; toggle themes"/>
                            </TextBlock>
                        </Grid>

                        <!-- Tip 2: Alt + H Hide -->
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource KeycapBadge}" HorizontalAlignment="Left">
                                <TextBlock Text="Alt + H" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11.5" Foreground="#E2E8F0">
                                <Run FontWeight="SemiBold" Text="Instant hide / show"/>
                                <Run Foreground="#94A3B8" Text=" — toggle overlay visibility on the fly"/>
                            </TextBlock>
                        </Grid>

                        <!-- Tip 3: Alt + F Fullscreen Vibe Mode -->
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource KeycapBadge}" HorizontalAlignment="Left">
                                <TextBlock Text="Alt + F" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11.5" Foreground="#E2E8F0">
                                <Run FontWeight="SemiBold" Text="Fullscreen Vibe Mode"/>
                                <Run Foreground="#94A3B8" Text=" — fluid 5-color glass backdrop, hover album controls + pop-out volume bar, and Kinetic Mode (Beta) via K"/>
                            </TextBlock>
                        </Grid>

                        <!-- Tip 4: Alt + [ / ] Nudge -->
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource KeycapBadge}" HorizontalAlignment="Left">
                                <TextBlock Text="Alt + [ / ]" FontSize="11" FontWeight="Bold" Foreground="#38BDF8"/>
                            </Border>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11.5" Foreground="#E2E8F0">
                                <Run FontWeight="SemiBold" Text="Nudge lyrics sync"/>
                                <Run Foreground="#94A3B8" Text=" — shift timing live in-game (+/- 100ms)"/>
                            </TextBlock>
                        </Grid>

                        <!-- Tip 5: Borderless Windowed -->
                        <Grid Margin="0,0,0,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="6" Background="#263328" BorderBrush="#404ADE80" BorderThickness="1"
                                    Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="In-Game Tip" FontSize="10.5" FontWeight="Bold" Foreground="#4ADE80"/>
                            </Border>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11.5" Foreground="#E2E8F0">
                                <Run FontWeight="SemiBold" Text="Borderless Windowed"/>
                                <Run Foreground="#94A3B8" Text=" — required for overlays over full games"/>
                            </TextBlock>
                        </Grid>

                        <!-- Tip 6: System Tray -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="6" Background="#2D2235" BorderBrush="#50C084FC" BorderThickness="1"
                                    Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="System Tray" FontSize="10.5" FontWeight="Bold" Foreground="#C084FC"/>
                            </Border>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11.5" Foreground="#E2E8F0">
                                <Run FontWeight="SemiBold" Text="Right-click tray icon"/>
                                <Run Foreground="#94A3B8" Text=" — reset position, change settings, or report bugs"/>
                            </TextBlock>
                        </Grid>
                    </StackPanel>

                    <!-- Row 3: Action Button & Micro-hint -->
                    <StackPanel Grid.Row="3" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Start Listening" Width="140" Height="34" Cursor="Hand" Click="OnCloseClicked">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" CornerRadius="10" Background="#3038BDF8" BorderBrush="#38BDF8" BorderThickness="1">
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="12.5" FontWeight="SemiBold" Foreground="#38BDF8"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#5538BDF8"/>
                                            <Setter TargetName="b" Property="BorderBrush" Value="#7DD3FC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <TextBlock Text="Press Esc or ✕ to close" FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ========================================== -->
                <!-- 2. RETURNING QUICK SPLASH PILL (Compact)   -->
                <!-- ========================================== -->
                <Grid x:Name="QuickSplashCard" Visibility="Collapsed" Width="360" Margin="16,12,16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="#1F2332"
                            BorderBrush="#33FFFFFF" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Image x:Name="ImgSplashIcon" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Margin="3"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="LyricalWidget" FontSize="14.5" FontWeight="Bold" Foreground="#F8FAFC"/>

                            <!-- Zero Two Rose-Crimson 002 Badge -->
                            <Border CornerRadius="6" Background="#26FF3B6B" BorderBrush="#80FF3B6B" BorderThickness="1"
                                    Padding="5,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="v2.0.002" FontSize="9.5" FontWeight="Bold" Foreground="#FF3B6B"/>
                                    <TextBlock Text="•" FontSize="7.5" Foreground="#80FF3B6B" Margin="3,0,3,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="002" FontSize="8.5" FontWeight="SemiBold" Foreground="#FF6B8B" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="made with love by 9headache" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
