<Window x:Class="LyricalWidget.AppDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LyricalWidget"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Inter, Segoe UI Variable Text, Segoe UI">
    <Grid Margin="32">
        <!-- Shadow on its own layer so text is not rasterized by the effect -->
        <Border CornerRadius="20" Background="#07080B">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" Direction="270" ShadowDepth="4" Color="#000000" Opacity="0.75"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="20" Width="420" Background="#07080B" BorderBrush="#17FFFFFF" BorderThickness="1">
            <Grid>
                <Border VerticalAlignment="Top" Height="1" Margin="24,0,24,0" Background="{StaticResource ChromeSheenBrush}"/>

                <StackPanel Margin="24,24,24,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="40" Height="40" CornerRadius="20" Background="#0E1016" BorderBrush="#17FFFFFF" BorderThickness="1"
                                Margin="0,0,16,0" VerticalAlignment="Top">
                            <Path x:Name="GlyphPath" Stroke="{StaticResource ChromeFillBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtHeadline" FontSize="16" FontWeight="Bold" Foreground="{StaticResource ChromeTextBrush}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtMessage" FontSize="12.5" Foreground="#A1A1AA" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,22,0,0">
                        <Button x:Name="BtnSecondary" Style="{StaticResource ChromeSecondaryButton}" HorizontalAlignment="Left"
                                Visibility="Collapsed" Click="OnSecondaryClicked"/>
                        <Button x:Name="BtnDone" Content="Done" Style="{StaticResource ChromePrimaryButton}" HorizontalAlignment="Right"
                                IsDefault="True" IsCancel="True" Click="OnDoneClicked"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
